<Window x:Class="EsteknikCRM1.BoschEmployeeLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#E6E6E6"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- TopBar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>
        <!-- ===================== -->
        <!-- TOP BAR -->
        <!-- ===================== -->
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal"
    HorizontalAlignment="Left">
                <Button Content="←"
                Width="50"
                Height="40"
                Click="Back_Click"
                BorderThickness="0"
                Background="Transparent"
                Foreground ="Black"
                FontSize="18"
                Cursor="Hand"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

                <!-- Minimize -->
                <Button Content="─"
                Width="50"
                Height="40"
                BorderThickness="0"
                FontSize="18"
                Cursor="Hand"
                Click="Minimize_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DDDDDD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close -->
                <Button Content="X"
                Width="50"
                Height="40"
                BorderThickness="0"
                FontSize="16"
                Cursor="Hand"
                Click="Close_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Red"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Grid>

        <!-- LOGIN CARD -->
        <Border Grid.Row="1"
                Width="420"
                Padding="40"
                Background="White"
                CornerRadius="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="BOSCH"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="Red"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Oturum açın"
                           FontSize="20"
                           Margin="0,0,0,20"/>

                <!-- Email Küçük Gösterim -->
                <TextBlock x:Name="EmailPreview"
                           Visibility="Collapsed"
                           Foreground="Gray"
                           Margin="0,0,0,10"/>

                <!-- EMAIL PANEL -->
                <StackPanel x:Name="EmailPanel">
                    <TextBox x:Name="EmailBox"
                             Height="40"
                             FontSize="15"
                             Margin="0,0,0,20"
                             BorderThickness="0,0,0,1"
                             BorderBrush="Gray"
                             Background="Transparent"
                             Text="user@bosch.com"/>
                </StackPanel>

                <!-- PASSWORD PANEL -->
                <StackPanel x:Name="PasswordPanel"
                            Visibility="Collapsed">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="40"
                                 Margin="0,0,0,20"
                                 BorderThickness="0,0,0,1"
                                 BorderBrush="Gray"
                                 Background="Transparent"/>
                </StackPanel>

                <Button x:Name="ActionButton"
                        Content="İleri"
                        Height="35"
                        Width="120"
                        HorizontalAlignment="Right"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ActionButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>

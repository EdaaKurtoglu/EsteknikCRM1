<Window x:Class="EsteknikCRM1.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- SIDEBAR BUTTON STYLE -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8"/>
                </Trigger>

                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderPopupButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F7FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- WINDOW CONTROL BAR -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Border Background="Transparent"
                    MouseDown="TopBar_MouseDown"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="—"
                        Width="60"
                        Background="Transparent"
                        Foreground="Blue"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Minimize_Click"/>

                <Button Content="✕"
                        Width="60"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="Red"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- TOP COLOR STRIP -->
        <Grid Grid.Row="1">
            <Image Source="/bgcolor.png"
                   Stretch="UniformToFill"/>
        </Grid>

        <!-- HEADER -->
        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Border Grid.Column="0"
                    VerticalAlignment="Center"
                    Padding="22,6,0,6">
                <Image Source="/assets/ttsm.png"
                       Height="100"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="Servis Yönetim Programı"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="16"
                       FontWeight="Medium"/>

            <!-- Right user area -->
            <Grid Grid.Column="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Notification -->
                <Button Grid.Column="0"
                        Style="{StaticResource HeaderMenuButtonStyle}">
                    <TextBlock Text="🔔"
                               FontSize="20"
                               VerticalAlignment="Center"/>
                </Button>

                <!-- User dropdown -->
                <Grid Grid.Column="2">
                    <ToggleButton x:Name="UserMenuButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Padding="0"
                                  HorizontalAlignment="Right"
                                  FocusVisualStyle="{x:Null}">
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        Width="46"
                                        Height="46"
                                        CornerRadius="23"
                                        Background="#1565C0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="UserInitialText"
                                               Text="E"
                                               Foreground="White"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- User texts -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameText"
                                               Text="Kullanıcı Adı"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"/>
                                    <TextBlock x:Name="UserRoleText"
                                               Text="Admin"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Arrow -->
                                <TextBlock Grid.Column="4"
                                           Text="▼"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=UserMenuButton}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=UserMenuButton}">
                        <Border Background="White"
                                CornerRadius="10"
                                Padding="10"
                                Width="220"
                                Margin="0,8,0,0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Background="#F8FAFC"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="PopupUserNameText"
                                                   Text="Kullanıcı Adı"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#1E293B"/>
                                        <TextBlock x:Name="PopupUserRoleText"
                                                   Text="Admin"
                                                   FontSize="13"
                                                   Foreground="#64748B"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="👤 Profilim"
                                        Style="{StaticResource HeaderPopupButtonStyle}"/>

                                <Button Content="🔐 Şifre Değiştir"
                                        Style="{StaticResource HeaderPopupButtonStyle}"/>

                                <Separator Margin="4,8"/>

                                <Button Content="🚪 Çıkış Yap"
                                        Style="{StaticResource HeaderPopupButtonStyle}"
                                        Click="Logout_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <Button x:Name="HomeBtn"
                                Content="🏠 Anasayfa"
                                Style="{StaticResource SidebarButtonStyle}"
                                Tag="Active"
                                Click="Menu_Click"/>

                        <Button x:Name="WorkflowBtn"
                                Content="🔄 İş Akışlar"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Expander x:Name="OperationsExpander"
                                  Background="White"
                                  BorderThickness="0"
                                  FontSize="14">
                            <Expander.Header>
                                <Border Height="45"
                                        Padding="20,0"
                                        VerticalAlignment="Center"
                                        Background="White">
                                    <TextBlock Text="⚙ İşlemler"
                                               VerticalAlignment="Center"
                                               Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <StackPanel Background="#FAFAFA">
                                <Button x:Name="StockActionBtn" 
                                    Content="   📦 Stok Hareketleri"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="StockAction_Click"/>
                                <Button x:Name="HakedisActionBtn"
                                    Content="   📦 Hakediş Kayıtları"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="HakedisAction_Click"/>
                                <Button x:Name="ReturnOperationBtn"
                                    Content="   📦 İade İşlemleri"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="ReturnOperation_Click"/>
                                <Button x:Name="FreeMaterialBtn"
                                    Content="   📦 Bedelsiz Malzeme Talepleri"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="FreeMaterial_Click"/>
                                <Button x:Name="ServiceLocationBtn"
                                    Content="   📦 Servis Lokasyon"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="ServiceLocation_Click"/>
                                <Button x:Name="AppointmentBtn" 
                                    Content="   📅 Randevu"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="Appointment_Click"/>
                                <Button x:Name="PriceProductButton" 
                                    Content="   📦 Ücretli Siparişler"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="StockAction_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="CardsExpander"
                                  Background="White"
                                  BorderThickness="0"
                                  FontSize="14">
                            <Expander.Header>
                                <Border Height="45"
                                        Padding="20,0"
                                        VerticalAlignment="Center"
                                        Background="White">
                                    <TextBlock Text="💳 Kartlar"
                                               VerticalAlignment="Center"
                                               Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <StackPanel Background="#FAFAFA">
                                <Button x:Name="IndividualCustomerCardsBtn" 
                                    Content="   👤 Bireysel Müşteri Kartı"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="IndividualCustomerCards_Click"/>
                                <Button x:Name="CorporateCustomerCardsBtn" 
                                    Content="   👤 Kurumsal Müşteri Kartı"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="CorporateCustomerCards_Click"/>
                                <Button x:Name="DeviceCardsBtn" 
                                    Content="   💻 Cihaz Kartı"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="DeviceCards_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="DefinitionsExpander"
                                  Background="White"
                                  BorderThickness="0"
                                  FontSize="14">
                            <Expander.Header>
                                <Border Height="45"
                                        Padding="20,0"
                                        VerticalAlignment="Center"
                                        Background="White">
                                    <TextBlock Text="🗂 Tanımlar"
                                               VerticalAlignment="Center"
                                               Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <StackPanel Background="#FAFAFA">
                                <Button x:Name="TeamDefinitionsBtn" 
                                    Content="   Ekip Tanımları"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="TeamDefinitions_Click"/>
                                <Button x:Name="DutyDefinitionsBtn" 
                                    Content="   Nöbet Tanımları"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="DutyDefinitions_Click"/>
                                <Button x:Name="SparePartDefinitionsBtn" 
                                    Content="   Yedek Parça Tanımları"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="SparePartDefinitions_Click"/>
                                <Button x:Name="ProductDefinitionsBtn" 
                                    Content="   Ürün Tanımları"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="ProductDefinitions_Click"/>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="ReportsBtn"
                                Content="📊 Reports"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Button x:Name="OtherApplicationsBtn"
                                Content="🔗 Other Applications"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Button x:Name="DocumentsBtn"
                                Content="📁 Documents"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Expander x:Name="ContactsExpander"
                                  Background="White"
                                  BorderThickness="0"
                                  FontSize="14">
                            <Expander.Header>
                                <Border Height="45"
                                        Padding="20,0"
                                        VerticalAlignment="Center"
                                        Background="White">
                                    <TextBlock Text="📞 Contact"
                                               VerticalAlignment="Center"
                                               Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <StackPanel Background="#FAFAFA">
                                <Button x:Name="EMessageBtn" 
                                    Content="   E-Messages"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="EMessage_Click"/>
                                <Button x:Name="NotificationsBtn" 
                                    Content="   Notifications"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="Notifications_Click"/>
                                <Button x:Name="MagazineBtn"
                                    Content="   Bosch Corporate Magazine"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Background="#FAFAFA"
                                        Click="Magazine_Click"/>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="EmpAddButton"
                                Content="+ Çalışan Ekle"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Button x:Name="BoschTTBtn"
                                Content="🚗 Bosch TT"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Button x:Name="ManagementBtn"
                                Content="👨‍💼 Management"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>

                        <Button x:Name="HelpBtn"
                                Content="❓ Help"
                                Style="{StaticResource SidebarButtonStyle}"
                                Click="Menu_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- FRAME -->
            <Frame x:Name="MainFrame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- BOTTOM COLOR STRIP -->
        <Grid Grid.Row="4">
            <Image Source="/bgcolor.png"
                   Stretch="UniformToFill"/>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="5" Background="White" Opacity="0.95">
            <TextBlock Text="© 2026 Es Teknik CRM - Tüm Hakları Saklıdır"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="12"/>
        </Grid>
    </Grid>
</Window>
<Window x:Class="EsteknikCRM1.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>

        <!-- SIDEBAR BUTTON STYLE -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>
            

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8"/>
                </Trigger>

                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>
        
    </Window.Resources>

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <!-- Window Control -->
            <RowDefinition Height="25"/>
            <!-- Background Image Row -->
            <RowDefinition Height="110"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="25"/>
            <!-- Image -->
            <RowDefinition Height="40"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        
        <!-- ========================= -->
        <!-- 1️⃣ WINDOW CONTROL BAR -->
        <!-- ========================= -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Drag Area -->
            <Border Background="Transparent"
                    MouseDown="TopBar_MouseDown"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="—"
                        Width="60"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Minimize_Click"/>

                <Button Content="✕"
                        Width="60"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="Red"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">

            <Image Source="/bgcolor.png"
               Stretch="UniformToFill"/>

        </Grid>

        <!-- ========================= -->
        <!-- 2️⃣ HEADER (Logo + User) -->
        <!-- ========================= -->
        <Grid Grid.Row="2" Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Border VerticalAlignment="Center"
                    Margin="0,0,0,0">
                <Image Source="/assets/ttsm.png"
                       Height="110"
                       Stretch="Uniform" Margin="0,0,26,0"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="Servis Yönetim Programı"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="16"/>

            <!-- User Info -->
            <Grid Grid.Column="2"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      Margin="0,0,20,0">

                <ToggleButton x:Name="UserMenuButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔔"
                       FontSize="18"
                       Margin="0,0,15,0"/>

                        <Ellipse Width="30"
                     Height="30"
                     Fill="#DDD"/>

                        <TextBlock x:Name="UserNameText"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="8,0,5,0"/>

                        <TextBlock Text="▼"
                       VerticalAlignment="Center"
                       FontSize="10"/>
                    </StackPanel>
                </ToggleButton>


                <!-- DROPDOWN -->
                <Popup PlacementTarget="{Binding ElementName=UserMenuButton}"
           Placement="Bottom"
           IsOpen="{Binding IsChecked, ElementName=UserMenuButton}"
           StaysOpen="False">

                    <Border Background="White"
                CornerRadius="6"
                Padding="10"
                Width="180"
                BorderBrush="#DDD"
                BorderThickness="1">

                        <StackPanel>

                            <Button Content="👤 Profilim"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="5"
                        Cursor="Hand"/>

                            <Button Content="🔐 Şifre Değiştir"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="5"
                        Cursor="Hand"/>

                            <Separator Margin="5"/>

                            <Button Content="🚪 Çıkış Yap"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="5"
                        Cursor="Hand"
                        Click="Logout_Click"/>

                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>

        </Grid>


        <!-- ========================= -->
        <!-- 3️⃣ CONTENT -->
        <!-- ========================= -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <Button x:Name="HomeBtn"
                            Content="🏠 Anasayfa"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Active"
                            Click="Menu_Click"/>

                        <Button x:Name="WorkflowBtn"
                            Content="🔄 İş Akışlar"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Expander x:Name="OperationsExpander"
                              Background="White"
                              BorderThickness="0"
                              FontSize="14">    

                            <!-- HEADER -->
                            <Expander.Header>
                                <Border Height="45"
                                    Padding="20,0"
                                    VerticalAlignment="Center"
                                    Background="White">
                                    <TextBlock Text="⚙ İşlemler"
                                       VerticalAlignment="Center"
                                       Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <!-- SUB MENU -->
                            <StackPanel Background="#FAFAFA">

                                <Button Content="   📦 Stok Hareketleri"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>
                                <Button Content="   📦 Hakediş Kayıtları"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>
                                <Button Content="   📦 İade İşlemleri"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>
                                <Button Content="   📦 Bedelsiz Malzeme Talepleri"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>
                                <Button Content="   📦 Servis Lokasyon"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>

                                <Button Content="   📅 Randevu"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="Appointment_Click"/>
                                <Button Content="   📦 Ücretli Siparişler"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="StockAction_Click"/>
                            </StackPanel>

                        </Expander>
                        <Expander x:Name="CardsExpander"
                              Background="White"
                              BorderThickness="0"
                              FontSize="14">

                            <!-- HEADER -->
                            <Expander.Header>
                                <Border Height="45"
                                    Padding="20,0"
                                    VerticalAlignment="Center"
                                    Background="White">
                                    <TextBlock Text="💳 Cards"
                                       VerticalAlignment="Center"
                                       Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <!-- SUB MENU -->
                            <StackPanel Background="#FAFAFA">

                                <Button Content="   👤 Individual Customer Cards"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="IndividualCustomerCards_Click"/>

                                <Button Content="   💻 Device Cards"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="DeviceCards_Click"/>

                            </StackPanel>

                        </Expander>

                        <Expander x:Name="DefinitionsExpander"
                          Background="White"
                          BorderThickness="0"
                          FontSize="14">

                            <!-- HEADER -->
                            <Expander.Header>
                                <Border Height="45"
                                    Padding="20,0"
                                    VerticalAlignment="Center"
                                    Background="White">
                                    <TextBlock Text="🗂 Definitions"
                                       VerticalAlignment="Center"
                                       Foreground="#444"/>
                                </Border>
                            </Expander.Header>

                            <!-- SUB MENU -->
                            <StackPanel Background="#FAFAFA">

                                <Button Content="   Spare Part Definitons"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="SparePartDefinitions_Click"/>



                            </StackPanel>

                        </Expander>
                        
                        <Button x:Name="ReportsBtn"
                            Content="📊 Reports"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="OtherApplicationsBtn"
                            Content="🔗 Other Applications"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="DocumentsBtn"
                            Content="📁 Documents"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>
                        <Expander x:Name="ContactsExpander"
                          Background="White"
                          BorderThickness="0"
                          FontSize="14">

                            <!-- HEADER -->
                            <Expander.Header>
                                <Border Height="45"
                                    Padding="20,0"
                                    VerticalAlignment="Center"
                                    Background="White">
                                    <TextBlock Text="📞 Contact"
                                       VerticalAlignment="Center"
                                       Foreground="#444"/>
                                </Border>
                            </Expander.Header>
                            

                            <!-- SUB MENU -->
                            <StackPanel Background="#FAFAFA">

                                <Button Content="   E-Messages"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="EMessage_Click"/>

                                <Button Content="   Notifications"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="Notifications_Click"/>

                                <Button Content="   Bosch Corporate Magazine"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="#FAFAFA"
                                    Click="Magazine_Click"/>

                            </StackPanel>

                        </Expander>
                        <Button x:Name="EmpAddButton"
                            Content="+ Çalışan Ekle"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>
                        <Button x:Name="BoschTTBtn"
                            Content="🚗 Bosch TT"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="ManagementBtn"
                            Content="👨‍💼 Management"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="HelpBtn"
                            Content="❓ Help"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>    
                    </StackPanel>
                </ScrollViewer>
                
            </Border>

            <!-- FRAME -->
            <Frame x:Name="MainFrame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"/>

        </Grid>
        <Grid Grid.Row="4">

            <Image Source="/bgcolor.png"
       Stretch="UniformToFill"/>

        </Grid>


        <!-- ========================= -->
        <!-- 4️⃣ FOOTER -->
        <!-- ========================= -->
        <Grid Grid.Row="5" Background="White" Opacity="0.9">
            <TextBlock Text="© 2026 Es Teknik CRM - Tüm Hakları Saklıdır"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="12"/>
        </Grid>

    </Grid>
</Window>

<Window x:Class="EsteknikCRM1.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>

        <!-- SIDEBAR BUTTON STYLE -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8"/>
                </Trigger>

                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <!-- Window Control -->
            <RowDefinition Height="25"/>
            <!-- Background Image Row -->
            <RowDefinition Height="110"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="25"/>
            <!-- Image -->
            <RowDefinition Height="40"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        
        <!-- ========================= -->
        <!-- 1️⃣ WINDOW CONTROL BAR -->
        <!-- ========================= -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- Drag Area -->
            <Border Background="Transparent"
                    MouseDown="TopBar_MouseDown"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="—"
                        Width="60"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Minimize_Click"/>

                <Button Content="✕"
                        Width="60"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="Red"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">

            <Image Source="/bgcolor.png"
               Stretch="UniformToFill"/>

        </Grid>

        <!-- ========================= -->
        <!-- 2️⃣ HEADER (Logo + User) -->
        <!-- ========================= -->
        <Grid Grid.Row="2" Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Border VerticalAlignment="Center"
                    Margin="0,0,0,0">
                <Image Source="/assets/ttsm.png"
                       Height="110"
                       Stretch="Uniform" Margin="0,0,26,0"/>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="Servis Yönetim Programı"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="16"/>

            <!-- User Info -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <TextBlock Text="🔔"
                           FontSize="18"
                           Margin="0,0,15,0"/>

                <Ellipse Width="30"
                         Height="30"
                         Fill="#DDD"/>

                <TextBlock Text=" Erdal GÜL"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="6,0,0,0"/>
            </StackPanel>

        </Grid>


        <!-- ========================= -->
        <!-- 3️⃣ CONTENT -->
        <!-- ========================= -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <Button x:Name="HomeBtn"
                            Content="🏠 Home"
                            Style="{StaticResource SidebarButtonStyle}"
                            Tag="Active"
                            Click="Menu_Click"/>

                        <Button x:Name="WorkflowBtn"
                            Content="🔄 Workflow"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>    

                        <Button x:Name="OperationsBtn"
                            Content="⚙ Operations"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="CardsBtn"
                            Content="💳 Cards"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="DefinitionsBtn"
                            Content="🗂 Definitions"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="ReportsBtn"
                            Content="📊 Reports"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="OtherApplicationsBtn"
                            Content="🔗 Other Applications"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="DocumentsBtn"
                            Content="📁 Documents"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="ContactBtn"
                            Content="📞 Contact"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="BoschTTBtn"
                            Content="🚗 Bosch TT"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="ManagementBtn"
                            Content="👨‍💼 Management"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>

                        <Button x:Name="HelpBtn"
                            Content="❓ Help"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Menu_Click"/>    
                    </StackPanel>
                </ScrollViewer>
                
            </Border>

            <!-- FRAME -->
            <Frame x:Name="MainFrame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"/>

        </Grid>
        <Grid Grid.Row="4">

            <Image Source="/bgcolor.png"
       Stretch="UniformToFill"/>

        </Grid>


        <!-- ========================= -->
        <!-- 4️⃣ FOOTER -->
        <!-- ========================= -->
        <Grid Grid.Row="5" Background="White" Opacity="0.9">
            <TextBlock Text="© 2026 Es Teknik CRM - Tüm Hakları Saklıdır"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       FontSize="12"/>
        </Grid>

    </Grid>
</Window>

<Page x:Class="EsteknikCRM1.Pages.ServiceTeamDefinitionsOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="ServiceTeamDefinitionsOperationPage">

    <Page.Resources>
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="TabTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Home" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Definitions" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Team Definitions" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Service Team Definitions Operation"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Team Definitions"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,30">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="36,0,0,0">
                        <Border Background="#E9E9E9" Padding="22,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="26" Margin="0,0,12,0"/>
                                <TextBlock Text="Team Main Page" Style="{StaticResource TabTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Height="4" Background="#14A0DB"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="⇄" FontSize="26" Margin="0,0,12,0"/>
                        <TextBlock Text="Workflows" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="◉" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Team Location" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🗎" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Team Competence" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🗓" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Appointments" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="◷" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Operation History" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="740"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="18,0,0,0">
                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="24,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Team Data"
                                   FontSize="18"
                                   Foreground="#1F2D3D"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <CheckBox x:Name="ActiveCheckBox"
                              Content="Active"
                              FontSize="18"
                              IsChecked="True"
                              Margin="0,0,0,24"/>

                    <TextBlock Text="Team Name"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="TeamNameTextBox"
                             Style="{StaticResource LineTextBoxStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Car Plaque"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="CarPlaqueTextBox"
                             Style="{StaticResource LineTextBoxStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Created Date"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="25/03/2026 00:33 +03:00"
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFBFBF"
                            BorderThickness="0,0,0,1"
                            Margin="0,0,0,22"/>

                    <TextBlock Text="Deactivation Date"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="DeactivationDateTextBox"
                             Style="{StaticResource LineTextBoxStyle}"
                             Foreground="#B5B5B5"/>
                </StackPanel>
            </Grid>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="⊘ Cancel"
                        Width="104"
                        Margin="0,0,12,0"
                        Style="{StaticResource OutlineBlueButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="💾 Save"
                        Width="92"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.Pages.AnnouncementDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F3F3"
      Title="AnnouncementDetailPage">

    <Grid Margin="14,10,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,14">
            <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="İletişim" Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="Duyuru/Bilgilendirme" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#0A67B2"
                Height="2"
                Margin="8,0,8,18"/>

        <TextBlock Grid.Row="2"
                   Text="Duyurular/Bilgilendirmeler"
                   FontSize="22"
                   Foreground="Black"
                   Margin="8,0,8,22"/>

        <!-- Tab -->
        <StackPanel Grid.Row="3" Margin="8,0,8,18">
            <Grid Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="❮"
                           FontSize="30"
                           Foreground="#9B9B9B"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="📢  Duyurular"
                               FontSize="16"
                               Foreground="#1F2D3D"/>
                    <Border Height="4"
                            Background="#14A0DB"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="❯"
                           FontSize="30"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="4" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AnnouncementListPanel"/>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="←"
                            Width="40"
                            Height="40"
                            FontSize="22"
                            Background="White"
                            BorderBrush="#D0D0D0"
                            Foreground="#A6A6A6"/>

                    <TextBlock Grid.Column="1"
                               Text="[1-5] / 547"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#0A67B2"
                               FontSize="16"/>

                    <Button Grid.Column="2"
                            Content="→"
                            Width="40"
                            Height="40"
                            FontSize="22"
                            Background="White"
                            BorderBrush="#14A0DB"
                            Foreground="#14A0DB"/>
                </Grid>
            </Grid>

            <!-- RIGHT -->
            <Border Grid.Column="2"
                    Background="#F7F7F7"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="‹"
                                Width="42"
                                Height="30"
                                Background="White"
                                BorderBrush="#D0D0D0"
                                Foreground="#0A67B2"
                                Click="BackButton_Click"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="AnnouncementDateText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="26/09/2025 09:49"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Right"
                               Foreground="#3C78B6"
                               FontSize="14"
                               Text="ⓘ Bu duyuruyu görüntülediğinize dair bilgilendirme yayınlayan kişiye gönderilmiştir."/>

                    <StackPanel Grid.Row="2" Margin="0,22,0,18">
                        <TextBlock x:Name="AnnouncementTitleText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#263238"
                                   Text="Sentinel Kampanya Bilgilendirmesi"/>
                        <Border BorderBrush="#D9D9D9"
                                BorderThickness="0,0,0,1"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               x:Name="AnnouncementBodyText"
                               FontSize="18"
                               Foreground="#263238"
                               TextWrapping="Wrap"
                               LineHeight="34"/>

                    <ItemsControl x:Name="FilesItemsControl"
              Grid.Row="4"
              Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DADADA"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding FileName}"/>

                                        <TextBlock FontSize="13"
                               Foreground="#777"
                               Margin="0,4,0,6"
                               Text="{Binding FileSize}"/>

                                        <Button Content="↓ İndir"
                            Width="90"
                            Height="30"
                            HorizontalAlignment="Left"
                            Background="White"
                            Foreground="#1E88E5"
                            BorderBrush="#1E88E5"
                            Click="DownloadFile_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
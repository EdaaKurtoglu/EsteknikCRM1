<Page x:Class="EsteknikCRM1.Pages.AnnouncementAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F3F3"
      Title="AnnouncementAddPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Yeni Duyuru Ekle"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,25"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Başlık" Margin="0,0,0,8"/>
            <TextBox x:Name="SubjectTextBox" Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="İçerik" Margin="0,0,0,8"/>
            <TextBox x:Name="BodyTextBox"
                     Height="180"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Dosyalar" Margin="0,0,0,8"/>

            <Button Content="Dosya Ekle"
                    Width="120"
                    Height="36"
                    HorizontalAlignment="Left"
                    Background="#005A9E"
                    Foreground="White"
                    BorderBrush="#005A9E"
                    Click="AddFileButton_Click"/>

            <ListBox x:Name="FilesListBox"
                     Margin="0,15,0,0"
                     Height="180"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Vazgeç"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="White"
                    Foreground="#005A9E"
                    BorderBrush="#005A9E"
                    Click="CancelButton_Click"/>

            <Button Content="Kaydet"
                    Width="100"
                    Height="40"
                    Background="#005A9E"
                    Foreground="White"
                    BorderBrush="#005A9E"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
<Page x:Class="EsteknikCRM1.Pages.WorkflowWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">

    <Grid>

        <!-- CARD -->
        <Border Width="500"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>

                <!-- TITLE -->
                <TextBlock Text="Yeni İş Akışı"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,25"/>

                <!-- COMBOBOX -->
                <TextBlock Text="İş Akışı Başlangıç Tipi"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <ComboBox x:Name="StartTypeBox"
                          Height="38"
                          Margin="0,8,0,0"
                          SelectionChanged="StartTypeBox_SelectionChanged">

                    <ComboBoxItem Content="Bireysel Müşteri"/>
                    <ComboBoxItem Content="Kurumsal Müşteri"/>

                </ComboBox>


                <!-- CUSTOMER AREA -->
                <StackPanel x:Name="CustomerSelectionPanel"
                            Visibility="Collapsed"
                            Margin="0,25,0,0">

                    <TextBlock Text="Müşteri"
                               FontWeight="SemiBold"
                               Foreground="#555"/>

                    <TextBox x:Name="CustomerNameBox"
                             Height="38"
                             Margin="0,8,0,0"
                             IsReadOnly="True"
                             Background="#F7F7F7"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <Button Content="Müşteri Ara"
                                Width="120"
                                Height="36"
                                Background="#1565C0"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Click="SearchCustomer_Click"/>

                        <Button Content="Müşteri Ekle"
                                Width="120"
                                Height="36"
                                Background="#2E7D32"
                                Foreground="White"
                                BorderThickness="0"
                                Click="AddCustomer_Click"/>

                    </StackPanel>
                    <!-- ADDRESS AREA -->
                    <StackPanel x:Name="AddressSelectionPanel"
                        Visibility="Collapsed"
                        Margin="0,25,0,0">

                        <TextBlock Text="Müşteri Adresi"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                        <ComboBox x:Name="AddressComboBox"
                          Height="38"
                          Margin="0,8,0,0"
                          DisplayMemberPath="AddressLine"
                          SelectionChanged="AddressComboBox_SelectionChanged"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Page>
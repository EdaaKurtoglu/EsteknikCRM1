<Page x:Class="EsteknikCRM1.Pages.WorkflowWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="WorkflowWizardPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#BDBDBD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="26"
                                    Height="26"
                                    Background="#D9D9D9"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    Margin="0,0,14,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#F3F3F3">

        <!-- START + WORKFLOW FULL PAGE -->
        <Grid x:Name="WizardCard"
              Visibility="Visible"
              Margin="16,10,16,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışlar" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışları İşlem"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="İş Akış Bilgileri"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,26">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="36,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘"
                                       FontSize="24"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="İş Akış Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷"
                                       FontSize="24"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Eskalasyon Geçmişi"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="4">

                <!-- START PANEL -->
                <Grid x:Name="StartPanel"
                      Margin="0,8,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Start type -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="İs Akisi Başlangıç Tipi"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="StartTypeBox"
                                  Style="{StaticResource FlatComboBoxStyle}"
                                  SelectionChanged="StartTypeBox_SelectionChanged">
                            <ComboBoxItem Content="Lütfen seçiniz..."/>
                            <ComboBoxItem Content="Bireysel Müşteri"/>
                            <ComboBoxItem Content="Kurumsal Müşteri"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Customer -->
                    <Grid x:Name="CustomerSelectionPanel"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Müşteri"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="CustomerNameBox"
                                     Style="{StaticResource FlatTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="⌕ Müşteri Ara"
                                Width="135"
                                Margin="0,26,0,0"
                                Style="{StaticResource BlueButtonStyle}"
                                Click="SearchCustomer_Click"/>

                        <Button Grid.Column="3"
                                x:Name="AddCustomerButton"
                                Content="+ Yeni Müşteri Ekle"
                                Width="175"
                                Margin="0,26,0,0"
                                Style="{StaticResource GrayButtonStyle}"
                                Click="AddCustomer_Click"/>
                    </Grid>

                    <!-- Address -->
                    <Grid x:Name="AddressSelectionPanel"
                          Grid.Row="2"
                          Visibility="Collapsed"
                          Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Müşteri Adres"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,8"/>

                            <Grid Background="#ECECEC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="AddressComboBox"
                                          Grid.Column="0"
                                          Height="50"
                                          FontSize="16"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          DisplayMemberPath="AddressLine"
                                          SelectionChanged="AddressComboBox_SelectionChanged"/>

                                <Button Grid.Column="1"
                                        Content="✕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"
                                        Foreground="#444"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="⌕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="26"
                                        Foreground="#2D3A4A"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,26,0,0">
                            <Button x:Name="AddAddressButton"
                                    Content="+ Yeni Adres Ekle"
                                    Width="160"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource GrayButtonStyle}"
                                    Click="AddCustomerAddresses_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dots -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,16">
                        <Ellipse Width="20" Height="20" Fill="#1296DB"/>
                        <Ellipse Width="20" Height="20" Fill="#D9D9D9" Margin="8,0,0,0"/>
                        <Ellipse Width="20" Height="20" Fill="#D9D9D9" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Next -->
                    <Button x:Name="NextButton"
                            Grid.Row="4"
                            Content="→İleri"
                            Width="86"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GrayButtonStyle}"
                            Click="NextButton_Click"/>
                </Grid>

                <!-- WORKFLOW PANEL -->
                <Grid x:Name="WorkflowPanel"
                      Visibility="Collapsed"
                      Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="CategoryPanel" Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Kategori"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="CategoryBox"
                                  Style="{StaticResource FlatComboBoxStyle}"
                                  DisplayMemberPath="Category"
                                  SelectionChanged="CategoryBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="NotificationsPanel"
                                Grid.Row="1"
                                Visibility="Collapsed"
                                Margin="0,0,0,18">
                        <TextBlock Text="Bildirim Tipi"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="NotificationTypeBox"
                                  Style="{StaticResource FlatComboBoxStyle}"
                                  DisplayMemberPath="NotificationType"
                                  SelectionChanged="NotificationTypeBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="SubCategoryPanel"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Margin="0,0,0,18">
                        <TextBlock Text="Alt Kategori"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="SubCategoryBox"
                                  Style="{StaticResource FlatComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SubCategoryBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="DevicePanel"
                                Grid.Row="3"
                                Visibility="Collapsed"
                                Margin="0,0,0,18">
                        <TextBlock Text="Cihaz"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="DeviceBox"
                                  Style="{StaticResource FlatComboBoxStyle}"
                                  DisplayMemberPath="DeviceName"
                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                    </StackPanel>

                    <Button x:Name="WorkflowNextButton"
                            Grid.Row="4"
                            Visibility="Collapsed"
                            Content="İleri"
                            Width="120"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="WorkflowNextButton_Click"
                            IsEnabled="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- FULLSCREEN FINAL REPORT PANEL -->
        <Grid x:Name="FinalReportPanel"
              Background="#F3F3F3"
              Visibility="Collapsed"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ANA FORM -->
            <Border Grid.Row="0"
                    Background="#F7F7F7"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BAŞLIK -->
                        <TextBlock Grid.Row="0"
                                   Text="Bakım Formu"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- İKİ SÜTUN -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <!-- SOL -->
                            <StackPanel Grid.Column="0">

                                <GroupBox Header="Bakım Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Kategori: Bakım" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bildirim Tipi: Bilgi Talebi" Margin="0,0,0,6"/>
                                        <TextBlock Text="Alt Kategori: Bakım İçerik"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Müşteri Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="Adı-Soyadı: ORTAANADOLU KALKINMAAJANSI" Margin="0,0,0,6"/>
                                            <TextBlock Text="ORTA ANADOLU KALKINMA AJANSI - SELÇUK ECZA DEPOSU MUSTAFA KEMAL PAŞA BULVARI MEVLANA MAH. NO 79 KOCASİNAN KAYSERİ"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="Tel:-" Margin="0,0,0,6"/>
                                            <TextBlock Text="E-Posta:info@oran.org.tr"/>
                                        </StackPanel>

                                        <Button Grid.Row="1"
                                                Content="🗎 Güncelle"
                                                Width="110"
                                                Height="42"
                                                HorizontalAlignment="Right"
                                                Margin="0,16,0,0"
                                                Background="#005A9E"
                                                Foreground="White"
                                                BorderBrush="#005A9E"/>
                                    </Grid>
                                </GroupBox>

                                <CheckBox Content="Müşterinin kendisi değil"
                                          Margin="0,0,0,16"
                                          VerticalAlignment="Center"/>

                                <GroupBox Header="Cihaz Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Seri Numarası:407KCFT0FS07" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ürün Grubu Adı:ARNU24GTPC2 VRF Ic Unite - 4 Yon Kaset" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="Marka Adı:LG" Margin="0,0,0,6"/>
                                        <TextBlock Text="Üst Ürün Grubu Adı:LG VRF Sistemler" Margin="0,0,0,6"/>
                                        <TextBlock Text="Devreye Alma Tarihi:22/07/2017" Margin="0,0,0,6"/>
                                        <TextBlock Text="Garanti Bitiş Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Son Bakım Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Bilgisi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Başlangıç Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Bitiş Tarihi:-"/>
                                    </StackPanel>
                                </GroupBox>

                                <Border Background="#DCDCDC"
                                        Height="38"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="Bildirim Bilgileri"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               FontSize="14"/>
                                </Border>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Bildirim Açıklaması"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="DescriptionTextBox"
                                             Height="130"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="#BFBFBF"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- SAĞ -->
                            <StackPanel Grid.Column="2">

                                <Border Background="#DCDCDC"
                                        Height="38"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="Dosya Bilgileri"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               FontSize="14"/>
                                </Border>

                                <Border BorderBrush="#CFCFCF"
                                        BorderThickness="2"
                                        Margin="0,0,0,18"
                                        MinHeight="160"
                                        Padding="20">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Yüklenecek dosyaları sürükleyip buraya bırakın."
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,24"/>
                                        <Button Content="Dosyaları seçin"
                                                Width="120"
                                                Height="34"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="#1990E6"
                                                Foreground="#1990E6"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,30,0,30">
                                    <TextBlock Text="Ek Açıklama"
                                               Margin="0,0,0,12"/>
                                    <TextBox x:Name="ExtraDescriptionTextBox"
                                             Height="90"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="#BFBFBF"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Geliş Kanalı"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ArrivalChannelComboBox"
                                              Height="34"
                                              BorderThickness="0,0,0,1"
                                              BorderBrush="#BFBFBF"
                                              Background="Transparent">
                                        <ComboBoxItem Content="Lütfen seçiniz..."/>
                                        <ComboBoxItem Content="Telefon"/>
                                        <ComboBoxItem Content="WhatsApp"/>
                                        <ComboBoxItem Content="Web"/>
                                        <ComboBoxItem Content="Email"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ALT BUTONLAR -->
            <Grid Grid.Row="1"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Geri"
                        Width="80"
                        Height="36"
                        HorizontalAlignment="Left"
                        Background="#005A9E"
                        Foreground="White"
                        BorderBrush="#005A9E"/>

                <Button Grid.Column="1"
                        Content="⊘ Vazgeç"
                        Width="96"
                        Height="42"
                        Background="White"
                        Foreground="#005A9E"
                        BorderBrush="#7FAED6"/>

                <Button Grid.Column="3"
                        Content="■ Genel Bilgi, Şikayet, Öneri Talebi Oluştur"
                        Height="42"
                        Padding="18,0"
                        Background="White"
                        Foreground="#005A9E"
                        BorderBrush="#7FAED6"
                        Click="SaveWorkflowButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
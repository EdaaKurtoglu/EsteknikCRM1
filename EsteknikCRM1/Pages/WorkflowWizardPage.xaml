<Page x:Class="EsteknikCRM1.Pages.WorkflowWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorkflowWizardPage">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- STEP INDICATOR -->
        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10">

            <Ellipse x:Name="Step1Indicator" Width="15" Height="15" Fill="#1565C0" Margin="5"/>
            <Ellipse x:Name="Step2Indicator" Width="15" Height="15" Fill="#CCC" Margin="5"/>
            <Ellipse x:Name="Step3Indicator" Width="15" Height="15" Fill="#CCC" Margin="5"/>

        </StackPanel>

        <!-- CONTENT AREA -->
        <Grid Grid.Row="1">

            <!-- STEP 1 -->
            <Grid x:Name="Step1Panel">
                <StackPanel Width="400">

                    <TextBlock Text="İş Akışı Başlangıç Tipi"
                           FontWeight="Bold"/>

                    <ComboBox x:Name="StartTypeBox"
                          Margin="0,10,0,0">
                        <ComboBoxItem Content="Bireysel Müşteri"/>
                        <ComboBoxItem Content="Kurumsal Müşteri"/>
                    </ComboBox>
                </StackPanel>
            </Grid>


            <!-- STEP 2 -->
            <Grid x:Name="Step2Panel"
              Visibility="Collapsed">
                <StackPanel Width="400">

                    <TextBlock Text="Müşteri Adı"
                           FontWeight="Bold"/>

                    <TextBox x:Name="CustomerNameBox"
                         Margin="0,10,0,0"/>

                </StackPanel>
            </Grid>


            <!-- STEP 3 -->
            <Grid x:Name="Step3Panel"
              Visibility="Collapsed">
                <StackPanel Width="400">

                    <TextBlock Text="Açıklama"
                           FontWeight="Bold"/>

                    <TextBox x:Name="DescriptionBox"
                         Height="100"
                         AcceptsReturn="True"
                         Margin="0,10,0,0"/>

                </StackPanel>
            </Grid>

        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">

            <Button Content="Geri"
                Width="100"
                Margin="10"
                Click="Back_Click"/>

            <Button Content="İleri"
                Width="100"
                Margin="10"
                Click="Next_Click"/>
        </StackPanel>

    </Grid>
</Page>

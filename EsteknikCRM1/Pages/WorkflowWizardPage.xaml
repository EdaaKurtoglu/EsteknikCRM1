<Page x:Class="EsteknikCRM1.Pages.WorkflowWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">

    <Grid Background="#F4F6F9">

        <!-- BAŞLANGIÇ + WORKFLOW KARTI -->
        <Border x:Name="WizardCard"
                Width="500"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Visible">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>

                <!-- TITLE -->
                <TextBlock Text="Yeni İş Akışı"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,25"/>

                <!-- START PANEL -->
                <StackPanel x:Name="StartPanel">
                    <TextBlock Text="İş Akışı Başlangıç Tipi"
                               FontWeight="SemiBold"
                               Foreground="#555"/>

                    <ComboBox x:Name="StartTypeBox"
                              Height="38"
                              Margin="0,8,0,0"
                              SelectionChanged="StartTypeBox_SelectionChanged">
                        <ComboBoxItem Content="Bireysel Müşteri"/>
                        <ComboBoxItem Content="Kurumsal Müşteri"/>
                    </ComboBox>

                    <!-- CUSTOMER AREA -->
                    <StackPanel x:Name="CustomerSelectionPanel"
                                Visibility="Collapsed"
                                Margin="0,25,0,0">

                        <TextBlock Text="Müşteri"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <TextBox x:Name="CustomerNameBox"
                                 Height="38"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 Background="#F7F7F7"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <Button Content="Müşteri Ara"
                                    Width="120"
                                    Height="36"
                                    Background="#1565C0"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,10,0"
                                    Click="SearchCustomer_Click"/>

                            <Button Content="Müşteri Ekle"
                                    Width="120"
                                    Height="36"
                                    Background="#2E7D32"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="AddCustomer_Click"/>
                        </StackPanel>

                        <!-- ADDRESS AREA -->
                        <StackPanel x:Name="AddressSelectionPanel"
                                    Visibility="Collapsed"
                                    Margin="0,25,0,0">

                            <TextBlock Text="Müşteri Adresi"
                                       FontWeight="SemiBold"
                                       Foreground="#555"/>

                            <ComboBox x:Name="AddressComboBox"
                                      Height="38"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="AddressLine"
                                      SelectionChanged="AddressComboBox_SelectionChanged"/>
                        </StackPanel>

                        <Button Name="NextButton"
                                Content="İleri"
                                Width="120"
                                Height="38"
                                Margin="0,30,0,0"
                                HorizontalAlignment="Right"
                                Background="#1565C0"
                                Foreground="White"
                                Visibility="Collapsed"
                                Click="NextButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- WORKFLOW PANEL -->
                <StackPanel x:Name="WorkflowPanel"
                            Visibility="Collapsed"
                            Margin="0,25,0,0">

                    <StackPanel x:Name="CategoryPanel">
                        <TextBlock Text="Kategori"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <ComboBox x:Name="CategoryBox"
                                  Height="38"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="Category"
                                  SelectionChanged="CategoryBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="NotificationsPanel"
                                Visibility="Collapsed">
                        <TextBlock Text="Bildirim Tipi"
                                   Margin="0,15,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <ComboBox x:Name="NotificationTypeBox"
                                  Height="38"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="NotificationType"
                                  SelectionChanged="NotificationTypeBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="SubCategoryPanel"
                                Visibility="Collapsed">
                        <TextBlock Text="Alt Kategori"
                                   Margin="0,15,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <ComboBox x:Name="SubCategoryBox"
                                  Height="38"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SubCategoryBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="DevicePanel"
                                Visibility="Collapsed">
                        <TextBlock Text="Cihaz"
                                   Margin="0,15,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                        <ComboBox x:Name="DeviceBox"
                                  Height="38"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="DeviceName"
                                  SelectionChanged="DeviceBox_SelectionChanged"/>
                    </StackPanel>

                    <Button x:Name="WorkflowNextButton"
                            Visibility="Collapsed"
                            Content="İleri"
                            Width="120"
                            Height="38"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Right"
                            Background="#1565C0"
                            Foreground="White"
                            Click="WorkflowNextButton_Click"
                            IsEnabled="False"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- FULLSCREEN FINAL REPORT PANEL -->
        <Grid x:Name="FinalReportPanel"
              Background="#F3F3F3"
              Visibility="Collapsed"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ANA FORM -->
            <Border Grid.Row="0"
                    Background="#F7F7F7"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BAŞLIK -->
                        <TextBlock Grid.Row="0"
                                   Text="Bakım Formu"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- İKİ SÜTUN -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <!-- SOL TARAF -->
                            <StackPanel Grid.Column="0">

                                <GroupBox Header="Bakım Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Kategori: Bakım" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bildirim Tipi: Bilgi Talebi" Margin="0,0,0,6"/>
                                        <TextBlock Text="Alt Kategori: Bakım İçerik"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Müşteri Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="Adı-Soyadı: ORTAANADOLU KALKINMAAJANSI" Margin="0,0,0,6"/>
                                            <TextBlock Text="ORTA ANADOLU KALKINMA AJANSI - SELÇUK ECZA DEPOSU MUSTAFA KEMAL PAŞA BULVARI MEVLANA MAH. NO 79 KOCASİNAN KAYSERİ"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="Tel:-" Margin="0,0,0,6"/>
                                            <TextBlock Text="E-Posta:info@oran.org.tr"/>
                                        </StackPanel>

                                        <Button Grid.Row="1"
                                                Content="🗎 Güncelle"
                                                Width="110"
                                                Height="42"
                                                HorizontalAlignment="Right"
                                                Margin="0,16,0,0"
                                                Background="#005A9E"
                                                Foreground="White"
                                                BorderBrush="#005A9E"/>
                                    </Grid>
                                </GroupBox>

                                <CheckBox Content="Müşterinin kendisi değil"
                                          Margin="0,0,0,16"
                                          VerticalAlignment="Center"/>

                                <GroupBox Header="Cihaz Bilgileri"
                                          Margin="0,0,0,16"
                                          BorderBrush="#CFCFCF">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Seri Numarası:407KCFT0FS07" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ürün Grubu Adı:ARNU24GTPC2 VRF Ic Unite - 4 Yon Kaset" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="Marka Adı:LG" Margin="0,0,0,6"/>
                                        <TextBlock Text="Üst Ürün Grubu Adı:LG VRF Sistemler" Margin="0,0,0,6"/>
                                        <TextBlock Text="Devreye Alma Tarihi:22/07/2017" Margin="0,0,0,6"/>
                                        <TextBlock Text="Garanti Bitiş Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Son Bakım Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Bilgisi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Başlangıç Tarihi:-" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ek Garanti Bitiş Tarihi:-"/>
                                    </StackPanel>
                                </GroupBox>

                                <Border Background="#DCDCDC"
                                        Height="38"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="Bildirim Bilgileri"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               FontSize="14"/>
                                </Border>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Bildirim Açıklaması"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="130"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="#BFBFBF"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- SAĞ TARAF -->
                            <StackPanel Grid.Column="2">

                                <Border Background="#DCDCDC"
                                        Height="38"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="Dosya Bilgileri"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               FontSize="14"/>
                                </Border>

                                <Border BorderBrush="#CFCFCF"
                                        BorderThickness="2"
                                        Margin="0,0,0,18"
                                        MinHeight="160"
                                        Padding="20">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Yüklenecek dosyaları sürükleyip buraya bırakın."
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,24"/>
                                        <Button Content="Dosyaları seçin"
                                                Width="120"
                                                Height="34"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="#1990E6"
                                                Foreground="#1990E6"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,30,0,30">
                                    <TextBlock Text="Ek Açıklama"
                                               Margin="0,0,0,12"/>
                                    <TextBox Height="90"
                                             Background="Transparent"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="#BFBFBF"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Geliş Kanalı"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Height="34"
                                              BorderThickness="0,0,0,1"
                                              BorderBrush="#BFBFBF"
                                              Background="Transparent">
                                        <ComboBoxItem Content="Lütfen seçiniz..."/>
                                        <ComboBoxItem Content="Telefon"/>
                                        <ComboBoxItem Content="WhatsApp"/>
                                        <ComboBoxItem Content="Web"/>
                                        <ComboBoxItem Content="Email"/>
                                    </ComboBox>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ALT BUTONLAR -->
            <Grid Grid.Row="1"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Geri"
                        Width="80"
                        Height="36"
                        HorizontalAlignment="Left"
                        Background="#005A9E"
                        Foreground="White"
                        BorderBrush="#005A9E"/>

                <Button Grid.Column="1"
                        Content="⊘ Vazgeç"
                        Width="96"
                        Height="42"
                        Background="White"
                        Foreground="#005A9E"
                        BorderBrush="#7FAED6"/>

                <Button Grid.Column="3"
                        Content="■ Genel Bilgi, Şikayet, Öneri Talebi Oluştur"
                        Height="42"
                        Padding="18,0"
                        Background="White"
                        Foreground="#005A9E"
                        BorderBrush="#7FAED6"/>
            </Grid>

        </Grid>

    </Grid>
</Page>
<Page x:Class="EsteknikCRM1.Pages.DutyDefinitionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="DutyDefinitionsPage">

    <Page.Resources>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="LineTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="18,14,18,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Tanımlar" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Nöbet Tanımları"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,24"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Nöbet Tanımları"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,28"/>

            <!-- Filters -->
            <Grid Grid.Row="3" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="490"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="490"/>
                </Grid.ColumnDefinitions>

                <!-- Yıl -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Yıl"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="YearComboBox"
                              Style="{StaticResource LineComboBoxStyle}">
                        <ComboBoxItem Content="2026" IsSelected="True"/>
                        <ComboBoxItem Content="2025"/>
                        <ComboBoxItem Content="2024"/>
                    </ComboBox>
                </StackPanel>

                <!-- Ay -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ay"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="MonthComboBox"
                              Style="{StaticResource LineComboBoxStyle}">
                        <ComboBoxItem Content="Mart" IsSelected="True"/>
                        <ComboBoxItem Content="Ocak"/>
                        <ComboBoxItem Content="Şubat"/>
                        <ComboBoxItem Content="Nisan"/>
                    </ComboBox>
                </StackPanel>

                <!-- Şehir -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Şehir"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CityTextBox"
                                 Style="{StaticResource LineTextBoxStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="⌕"
                                   FontSize="28"
                                   Foreground="#2D3A4A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Bölge -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Bölge"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="RegionComboBox"
                              Style="{StaticResource LineComboBoxStyle}"
                              Foreground="#B5B5B5">
                        <ComboBoxItem Content="Lütfen seçiniz..." IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- List button -->
            <Grid Grid.Row="4" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="≣ Listele"
                        Width="100"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="ListButton_Click"/>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="155"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Grid area -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DutyGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="64"
                          RowHeight="48"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinHeight="112">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,8,10,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="290"/>
                        <DataGridTextColumn Header="Bölge" Binding="{Binding Region}" Width="210"/>
                        <DataGridTextColumn Header="Gün Dönemi" Binding="{Binding DayPeriod}" Width="330"/>
                        <DataGridTextColumn Header="Ürün Grubu" Binding="{Binding ProductGroup}" Width="320"/>
                        <DataGridTextColumn Header="Yetkili Servis" Binding="{Binding AuthorizedService}" Width="340"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <Grid x:Name="EmptyStatePanel"
                      Grid.Row="0"
                      Background="Transparent"
                      Panel.ZIndex="10"
                      IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1"
                            BorderBrush="#AEB6BF"
                            BorderThickness="1,0,1,1"
                            Background="White">
                        <TextBlock Text="No data available in table"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#333"/>
                    </Border>
                </Grid>

                <!-- Footer row -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="‹"
                                Style="{StaticResource PagerButtonStyle}"/>
                        <Button Content="›"
                                Style="{StaticResource PagerButtonStyle}"/>
                    </StackPanel>

                    <TextBlock x:Name="EmptyFooterText"
                               Grid.Column="2"
                               Text="Kayıt Bulunamadı"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,0,8"/>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
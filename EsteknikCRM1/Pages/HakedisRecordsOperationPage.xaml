<Page x:Class="EsteknikCRM1.Pages.HakedisRecordsOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="HakedisRecordsOperationPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="TopBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A67B2"/>
            <Setter Property="BorderBrush" Value="#0A67B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Margin="8,8,8,14"
            VerticalAlignment="Center">

                <Button Content="⌂ Anasayfa"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#9AA8B6"
            FontSize="14"
            Cursor="Hand"
            Click="Home_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="İşlemler"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            Cursor="Hand"
            Click="Operations_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="Hakediş Kayıtları"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            Cursor="Hand"
            Click="HakedisRecords_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="Hakediş Kayıtları İşlem"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            FontWeight="SemiBold"
            Cursor="Hand"
            IsEnabled="False"
            Click="HakedisOperation_Click"/>

            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="8,0,8,18"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Hakediş Kayıtları İşlem"
                       FontSize="22"
                       Margin="8,0,8,22"
                       Foreground="Black"/>

            <!-- Tabs -->
            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="8,0,8,18">
                <Grid Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Merkez -->
                    <StackPanel Grid.Column="0" Margin="38,0,0,0">
                        <Button x:Name="CenterTabButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Click="CenterTabButton_Click">
                            <TextBlock x:Name="CenterTabText"
                           Text="🏭  Hakediş (Merkez Ödeyecek) Bilgileri"
                           FontSize="16"
                           Foreground="#1F2D3D"/>
                        </Button>

                        <Border x:Name="CenterTabUnderline"
                    Height="4"
                    Background="#14A0DB"
                    Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Müşteri -->
                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                        <Button x:Name="CustomerTabButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Click="CustomerTabButton_Click">
                            <TextBlock x:Name="CustomerTabText"
                           Text="🏭  Hakediş (Müşteri Ödeyecek) Bilgileri"
                           FontSize="16"
                           Foreground="#1F2D3D"/>
                        </Button>

                        <Border x:Name="CustomerTabUnderline"
                    Height="4"
                    Background="Transparent"
                    Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Filter and toolbar -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">

                <Border Background="#E8E8E8"
                        BorderBrush="#D0D5DA"
                        BorderThickness="1"
                        Height="50">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="⌄" Foreground="#222" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filtreleri Göster" Foreground="#222" FontSize="16" Margin="0,0,34,0" VerticalAlignment="Center"/>
                        <TextBlock Text="◌" Foreground="#222" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filtreleri Sıfırla" Foreground="#222" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Margin="38,22,38,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="760"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Manuel Eklenebilecek İşçilik Listesi"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource FlatTextBoxStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="⌕"
                               FontSize="24"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4">
                        <TextBlock Text="Hızlı Arama"
                                   FontSize="16"
                                   Foreground="Black"
                                   Margin="0,0,28,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Kayıt Ara"
                                       FontSize="16"
                                       Foreground="#9E9E9E"
                                       Margin="0,0,0,8"/>
                            <Border Width="160"
                                    BorderBrush="#C9CDD2"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Grid.Row="5"
                      x:Name="HakedisOperationGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="72"
                      RowHeight="110"
                      FontSize="16"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MinHeight="500">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="8,8,8,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="▶"
                                           Foreground="#6E6E6E"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,36,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="58">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="⌘"
                                           Foreground="#6EA300"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           Margin="0,26,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Is&#x0a;Akisi(Fis&#x0a;No)" Binding="{Binding WorkflowReceiptNo}" Width="140"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="170"/>
                    <DataGridTextColumn Header="Servis&#x0a;Fisi&#x0a;Tipi" Binding="{Binding ServiceReceiptType}" Width="120"/>
                    <DataGridTextColumn Header="Cihaz Seri No" Binding="{Binding DeviceSerialNo}" Width="260"/>
                    <DataGridTextColumn Header="Ürün&#x0a;Kodu" Binding="{Binding ProductCode}" Width="130"/>
                    <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="180"/>
                    <DataGridTextColumn Header="İşçilik Adı" Binding="{Binding LaborName}" Width="150"/>
                    <DataGridTextColumn Header="Alt&#x0a;İşçilik&#x0a;Adı" Binding="{Binding SubLaborName}" Width="110"/>
                    <DataGridTextColumn Header="Tutar" Binding="{Binding Amount}" Width="110"/>
                    <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="1/1"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0,0,22,0"/>

                    <Button Content="⊘ Vazgeç"
                            Width="112"
                            Margin="0,0,12,0"
                            Style="{StaticResource OutlineBlueButtonStyle}"
                            Click="CancelButton_Click"/>

                    <Button Content="■ Hakediş Seti Oluştur"
                            Width="220"
                            Style="{StaticResource TopBlueButtonStyle}"
                            Click="CreateSetButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
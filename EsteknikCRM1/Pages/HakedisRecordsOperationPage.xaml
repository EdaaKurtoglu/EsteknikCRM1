<Page x:Class="EsteknikCRM1.Pages.HakedisRecordsOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="HakedisRecordsOperationPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="TopBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A67B2"/>
            <Setter Property="BorderBrush" Value="#0A67B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,8"
              MinWidth="1500"
              MinHeight="950">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,8,0,14"
                        VerticalAlignment="Center">

                <Button Content="⌂ Anasayfa"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Foreground="#9AA8B6"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Home_Click"/>

                <TextBlock Text="  >  "
                           Foreground="#9AA8B6"
                           FontSize="14"/>

                <Button Content="İşlemler"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Foreground="#0A67B2"
                        FontSize="14"
                        Cursor="Hand"
                        Click="Operations_Click"/>

                <TextBlock Text="  >  "
                           Foreground="#9AA8B6"
                           FontSize="14"/>

                <Button Content="Hakediş Kayıtları"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Foreground="#0A67B2"
                        FontSize="14"
                        Cursor="Hand"
                        Click="HakedisRecords_Click"/>

                <TextBlock Text="  >  "
                           Foreground="#9AA8B6"
                           FontSize="14"/>

                <Button Content="Hakediş Kayıtları İşlem"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Foreground="#0A67B2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        IsEnabled="False"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,18"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Hakediş Kayıtları İşlem"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"
                       Foreground="#1F2937"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">

                <Grid Margin="0,4,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Button x:Name="CenterTabButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Click="CenterTabButton_Click">

                            <TextBlock x:Name="CenterTabText"
                                       Text="🏭 Hakediş (Merkez Ödeyecek) Bilgileri"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D3D"/>

                        </Button>

                        <Border x:Name="CenterTabUnderline"
                                Height="4"
                                Background="#14A0DB"
                                Margin="0,14,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <Button x:Name="CustomerTabButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Click="CustomerTabButton_Click">

                            <TextBlock x:Name="CustomerTabText"
                                       Text="🏭 Hakediş (Müşteri Ödeyecek) Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>

                        </Button>

                        <Border x:Name="CustomerTabUnderline"
                                Height="4"
                                Background="Transparent"
                                Margin="0,14,0,0"/>

                    </StackPanel>

                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Toolbar -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">

                <Border Background="#E8E8E8"
                        BorderBrush="#D0D5DA"
                        BorderThickness="1"
                        Height="46">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">

                        <TextBlock Text="⌄"
                                   FontSize="16"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Filtreleri Göster"
                                   FontSize="15"
                                   Margin="0,0,34,0"/>

                        <TextBlock Text="◌"
                                   FontSize="16"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Filtreleri Sıfırla"
                                   FontSize="15"/>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- DataGrid -->
            <Border Grid.Row="5"
                    Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0">

                <DataGrid x:Name="HakedisOperationGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#D0D7DE"
                          VerticalGridLinesBrush="#D0D7DE"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="56"
                          RowHeight="58"
                          FontSize="14"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MinHeight="520"
                          MaxHeight="700">

                    <DataGrid.Resources>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="BorderBrush" Value="#D0D7DE"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#D0D7DE"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding Id}"
                                            Width="100"/>

                        <DataGridTextColumn Header="İş Akışı / Fiş No"
                                            Binding="{Binding WorkflowReceiptNo}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Müşteri"
                                            Binding="{Binding Customer}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Servis Fişi Tipi"
                                            Binding="{Binding ServiceReceiptType}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Cihaz Seri No"
                                            Binding="{Binding DeviceSerialNo}"
                                            Width="240"/>

                        <DataGridTextColumn Header="Ürün Kodu"
                                            Binding="{Binding ProductCode}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Ürün Adı"
                                            Binding="{Binding ProductName}"
                                            Width="220"/>

                        <DataGridTextColumn Header="İşçilik Adı"
                                            Binding="{Binding LaborName}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Alt İşçilik Adı"
                                            Binding="{Binding SubLaborName}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Tutar"
                                            Binding="{Binding Amount}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Miktar"
                                            Binding="{Binding Quantity}"
                                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- Footer -->
            <Grid Grid.Row="6" Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="⊘ Vazgeç"
                            Width="112"
                            Margin="0,0,12,0"
                            Style="{StaticResource OutlineBlueButtonStyle}"
                            Click="CancelButton_Click"/>

                    <Button Content="■ Hakediş Seti Oluştur"
                            Width="220"
                            Style="{StaticResource TopBlueButtonStyle}"
                            Click="CreateSetButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>
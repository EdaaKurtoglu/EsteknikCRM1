<Page x:Class="EsteknikCRM1.Pages.DeviceCardOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F3F3"
      Title="DeviceCardOperationPage">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,12,0,18"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
        </Style>

        <Style x:Key="LineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="LookupButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="⌕"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A67B2"/>
            <Setter Property="BorderBrush" Value="#0A67B2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Anasayfa" Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Kartlar" Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Cihaz Kartları" Foreground="#0A67B2" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Cihaz Kartları İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Title / Tabs -->
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#0A67B2" BorderThickness="0,0,0,2" Margin="0,0,0,18"/>

            <TextBlock Text="Cihaz Kartı"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,26"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="❮"
                           FontSize="34"
                           Foreground="#B7B7B7"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="⌘  Cihaz Bilgileri"
                               FontSize="16"
                               Foreground="#1F2D3D"/>
                    <Border Height="4"
                            Background="#14A0DB"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="⌂  Müşteri Geçmişi"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="🗎  Servis Geçmişi"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="4"
                           Text="⇄  İş Akışı Bilgileri"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="5"
                           Text="📋  Garanti Geçmişi"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="6"
                           Text="⚖  KL"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="7"
                           Text="❯"
                           FontSize="34"
                           Foreground="#000"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,0,0,18"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="Cihaz Bilgileri" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cihaz Kodu" Margin="0,12,0,8"/>
                            <TextBox x:Name="DeviceCodeTextBox" Style="{StaticResource LineTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource LookupButtonStyle}"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Cihaz Adı" Margin="0,12,0,8" Foreground="#C7C7C7"/>
                        <TextBox x:Name="DeviceNameTextBox" Style="{StaticResource LineTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Seri No" Margin="0,12,0,8" Foreground="#C7C7C7"/>
                        <TextBox x:Name="SerialNoTextBox" Style="{StaticResource LineTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Cihaz Durumu" Margin="0,12,0,8"/>
                        <ComboBox x:Name="DeviceStatusComboBox" Style="{StaticResource LineComboBoxStyle}">
                            <ComboBoxItem Content="Lütfen seçiniz..."/>
                            <ComboBoxItem Content="Aktif"/>
                            <ComboBoxItem Content="Pasif"/>
                            <ComboBoxItem Content="Arızalı"/>
                        </ComboBox>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Devreye Alma Tarihi" Margin="0,12,0,8" Foreground="#C7C7C7"/>
                            <DatePicker x:Name="CommissionDatePicker"
                                        Height="34"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#BFC5CC"
                                        Background="Transparent"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tesisat Tipi" Margin="0,12,0,8"/>
                            <TextBox x:Name="InstallationTypeTextBox" Style="{StaticResource LineTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource LookupButtonStyle}"/>
                    </Grid>

                </StackPanel>

                <!-- SAĞ -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="Cihaz Karaliste Durumu" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <CheckBox x:Name="BlacklistCheckBox"
                              Content="Karalistede"
                              FontSize="16"
                              Margin="0,8,0,22"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Nedeni" Margin="0,12,0,8" Foreground="#C7C7C7"/>
                        <ComboBox x:Name="BlacklistReasonComboBox" Style="{StaticResource LineComboBoxStyle}">
                            <ComboBoxItem Content="Lütfen seçiniz..."/>
                            <ComboBoxItem Content="Garanti Dışı"/>
                            <ComboBoxItem Content="Yetkisiz Müdahale"/>
                            <ComboBoxItem Content="Borç / Bloke"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,26">
                        <TextBlock Text="Açıklama" Margin="0,12,0,8" Foreground="#C7C7C7"/>
                        <TextBox x:Name="BlacklistDescriptionTextBox"
                                 Height="90"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0,0,0,1"
                                 BorderBrush="#BFC5CC"
                                 Background="Transparent"/>
                    </StackPanel>

                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="En Son Cihaz Sahibi Bilgisi" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <Border Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,18">
                        <TextBlock Text="Satış Yapan Bayi Bilgisi" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Satıcı Bayi" Margin="0,12,0,8"/>
                            <TextBox x:Name="DealerTextBox" Style="{StaticResource LineTextBoxStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource LookupButtonStyle}"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="⊘ Vazgeç"
                    Width="110"
                    Margin="0,0,12,0"
                    Style="{StaticResource OutlineBlueButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="🗎 Kaydet"
                    Width="110"
                    Style="{StaticResource PrimaryBlueButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
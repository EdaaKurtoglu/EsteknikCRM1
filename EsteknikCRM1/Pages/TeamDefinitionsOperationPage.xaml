<Page x:Class="EsteknikCRM1.Pages.TeamDefinitionsOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="TeamDefinitionsOperationPage">

    <Page.Resources>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MutedFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Foreground" Value="#B6B6B6"/>
        </Style>

        <Style x:Key="LineBoxStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#BCC3CA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CheckBoxStyleLarge" TargetType="CheckBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="30"
                                    Height="30"
                                    Background="#D9D9D9"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <TextBlock x:Name="Tick"
                                           Text="✓"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#005A9E"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="18,10,18,16" MinWidth="1540">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Margin="0,8,0,14"
            VerticalAlignment="Center">

                <Button Content="⌂ Anasayfa"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#9AA8B6"
            FontSize="14"
            Cursor="Hand"
            Click="Home_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="Tanımlar"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            Cursor="Hand"
            Click="Definitions_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="Ekip Tanımları"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            Cursor="Hand"
            Click="TeamDefinitions_Click"/>

                <TextBlock Text="  >  "
               Foreground="#9AA8B6"
               FontSize="14"
               VerticalAlignment="Center"/>

                <Button Content="Ekip Tanımları İşlem"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Foreground="#0A67B2"
            FontSize="14"
            FontWeight="SemiBold"
            Cursor="Hand"
            IsEnabled="False"
            Click="TeamDefinitionsOperation_Click"/>

            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,20"/>

            <!-- Title + Tabs -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <TextBlock Text="Ekip Tanımları"
                           FontSize="22"
                           Foreground="Black"
                           Margin="0,0,0,22"/>

                <StackPanel Orientation="Horizontal" Margin="36,0,0,18">
                    <StackPanel Margin="0,0,18,0">
                        <Button Content="⌂  Ekip Anasayfa"
                                Style="{StaticResource TabButtonStyle}"
                                HorizontalAlignment="Left"/>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="8,8,0,0"
                                Width="194"/>
                    </StackPanel>

                    <Button Content="⇄  İş Akışlar"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="⦿  Ekip Konum"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="🗎  Ekip Yetkinlikleri"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="🗓  Randevular"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="◴  İşlem Geçmişi"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>

                <Border BorderBrush="#E1E1E1"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main -->
            <Grid Grid.Row="2" Margin="0,133,558,0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="760"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="18,12,0,0">

                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="Ekip Bilgisi"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   FontSize="16"/>
                    </Border>

                    <CheckBox x:Name="IsActiveCheckBox"
                              Content="Aktif"
                              IsChecked="True"
                              Style="{StaticResource CheckBoxStyleLarge}"
                              Margin="0,6,0,26"/>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Ekip Adı" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource LineBoxStyle}">
                            <TextBox x:Name="TeamNameBox" Style="{StaticResource FlatTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Araç Plakası" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource LineBoxStyle}">
                            <TextBox x:Name="VehiclePlateBox" Style="{StaticResource FlatTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Eklenme Tarihi" Style="{StaticResource MutedFieldLabelStyle}"/>
                        <Border Style="{StaticResource LineBoxStyle}">
                            <TextBox x:Name="CreatedDateBox"
                                     Style="{StaticResource FlatTextBoxStyle}"
                                     IsReadOnly="True"
                                     Foreground="#B6B6B6"
                                     IsEnabled="False"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Pasifleştirme Tarihi" Style="{StaticResource MutedFieldLabelStyle}"/>
                        <Border Style="{StaticResource LineBoxStyle}">
                            <TextBox x:Name="PassiveDateBox"
                                     Style="{StaticResource FlatTextBoxStyle}"
                                     IsReadOnly="True"
                                     Foreground="#B6B6B6"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,18,558,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="⊘ İptal"
                            Width="110"
                            Margin="0,0,12,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="CancelButton_Click"/>

                    <Button Content="🗎 Kaydet"
                            Width="110"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
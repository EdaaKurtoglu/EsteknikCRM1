<Page x:Class="EsteknikCRM1.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="NotificationsPage"
      Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Notifications"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="20,15,0,10">

            <!-- Notifications Tab -->
            <Border Background="#E8E8E8"
                    CornerRadius="6"
                    Padding="15,8"
                    Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔔"
                               FontSize="16"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Notifications"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Add Notification -->
            <Border Background="Transparent"
                    Padding="15,8"
                    Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕"
                               FontSize="16"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Add Notification"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Submitted Notifications -->
            <Border Background="Transparent"
                    Padding="15,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🕘"
                               FontSize="16"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Submitted Notifications"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Notifications List -->
        <ScrollViewer Grid.Row="2"
                      Margin="20"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Notification Item 1 -->
                <Border Background="White"
                        Padding="20"
                        CornerRadius="6"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔔"
                                   FontSize="28"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Top"/>

                        <StackPanel>

                            <TextBlock>
                                <Run Text="Yeni duyuru yayınlandı "
                                     FontSize="16"
                                     FontWeight="SemiBold"/>
                                <Run Text="New"
                                     Foreground="Red"
                                     FontSize="14"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#1F4E79"
                                       FontWeight="SemiBold"
                                       Text="Turgut Can Özdemir"/>

                            <TextBlock Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,2,0,5"
                                       Text="is created, 4 hours ago, 18/02/2026 12:54 +03:00"/>

                            <TextBlock Text='"2026 Başarılı Teknisyenler Toplantı Duyurusu" başlığı yayınlandı.' 
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notification Item 2 -->
                <Border Background="White"
                        Padding="20"
                        CornerRadius="6"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔔"
                                   FontSize="28"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Top"/>

                        <StackPanel>

                            <TextBlock>
                                <Run Text="Rol güncellendi "
                                     FontSize="16"
                                     FontWeight="SemiBold"/>
                                <Run Text="New"
                                     Foreground="Red"
                                     FontSize="14"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#1F4E79"
                                       FontWeight="SemiBold"
                                       Text="System User"/>

                            <TextBlock Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,2,0,5"
                                       Text="is created, 6 hours ago, 18/02/2026 10:51 +03:00"/>

                            <TextBlock Text='"Yetkili Servis Teknisyen" rolü güncellendi.' 
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notification Item 3 -->
                <Border Background="White"
                        Padding="20"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔔"
                                   FontSize="28"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Top"/>

                        <StackPanel>

                            <TextBlock>
                                <Run Text="Servis kullanıcısı pasifleştirildi "
                                     FontSize="16"
                                     FontWeight="SemiBold"/>
                                <Run Text="New"
                                     Foreground="Red"
                                     FontSize="14"/>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#1F4E79"
                                       FontWeight="SemiBold"
                                       Text="System User"/>

                            <TextBlock Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,2,0,5"
                                       Text="is created, a day ago, 17/02/2026 15:30 +03:00"/>

                            <TextBlock Text='"14934" Id li kullanıcı pasif hale getirildi.' 
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Page>

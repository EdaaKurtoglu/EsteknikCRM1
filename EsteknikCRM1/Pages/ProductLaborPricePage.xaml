<Page x:Class="EsteknikCRM1.Pages.ProductLaborPricePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9" Height="758">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Fiyat Yönetimi"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                Padding="18"
                CornerRadius="8"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ProductCodeBox"
                         Grid.Column="0"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="Ürün Kodu"/>

                <TextBox x:Name="ProductNameBox"
                         Grid.Column="1"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="Ürün Adı"/>

                <TextBox x:Name="LaborCodeBox"
                         Grid.Column="2"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="İşçilik Kodu"/>

                <TextBox x:Name="LaborNameBox"
                         Grid.Column="3"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="İşçilik Adı"/>

                <TextBox x:Name="PriceBox"
                         Grid.Column="4"
                         Height="38"
                         Margin="0,0,10,0"
                         Tag="Fiyat"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Ekle"
                            Width="90"
                            Height="38"
                            Margin="0,0,8,0"
                            Background="#005A9E"
                            Foreground="White"
                            Click="AddButton_Click"/>

                    <Button Content="Güncelle"
                            Width="90"
                            Height="38"
                            Background="#2E7D32"
                            Foreground="White"
                            Click="UpdateButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="PricesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="PricesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" Width="120"/>
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="180"/>
                <DataGridTextColumn Header="İşçilik Kodu" Binding="{Binding LaborCode}" Width="120"/>
                <DataGridTextColumn Header="İşçilik Adı" Binding="{Binding LaborName}" Width="220"/>
                <DataGridTextColumn Header="Alt İşçilik" Binding="{Binding SubLaborName}" Width="160"/>
                <DataGridTextColumn Header="Fiyat" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Para Birimi" Binding="{Binding Currency}" Width="100"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/>

                <DataGridTemplateColumn Header="İşlem" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Sil"
                                    Background="#C62828"
                                    Foreground="White"
                                    Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
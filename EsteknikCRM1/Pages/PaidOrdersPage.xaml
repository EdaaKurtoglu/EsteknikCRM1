<Page x:Class="EsteknikCRM1.Pages.PaidOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="PaidOrdersPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="0,0,0,10" MinWidth="1580">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,18,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Ücretli Siparişler" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="18,0,18,24"/>

            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="0,20,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,18,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="210"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Grid area -->
            <Grid Grid.Row="3">
                <DataGrid x:Name="PaidOrdersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="108"
                          RowHeight="46"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinHeight="260"
                          Margin="0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,8,10,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="İş&#x0a;Akışı" Binding="{Binding WorkflowNo}" Width="95"/>
                        <DataGridTextColumn Header="Servis&#x0a;Kodu" Binding="{Binding ServiceCode}" Width="105"/>
                        <DataGridTextColumn Header="Servis&#x0a;Fişi" Binding="{Binding ServiceReceipt}" Width="105"/>
                        <DataGridTextColumn Header="Servis&#x0a;İsmi" Binding="{Binding ServiceName}" Width="120"/>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="120"/>
                        <DataGridTextColumn Header="Servis&#x0a;SAP&#x0a;Kodu" Binding="{Binding ServiceSapCode}" Width="110"/>
                        <DataGridTextColumn Header="Yedek&#x0a;Parça-&#x0a;Ürün&#x0a;İsmi" Binding="{Binding SparePartProductName}" Width="115"/>
                        <DataGridTextColumn Header="Yedek&#x0a;Parça-&#x0a;Ürün&#x0a;SAP&#x0a;Kodu" Binding="{Binding SparePartProductSapCode}" Width="115"/>
                        <DataGridTextColumn Header="SAP&#x0a;Sipariş&#x0a;Numarası" Binding="{Binding SapOrderNumber}" Width="120"/>
                        <DataGridTextColumn Header="SAP&#x0a;Durumu" Binding="{Binding SapStatus}" Width="110"/>
                        <DataGridTextColumn Header="SAP Siparişi&#x0a;Oluşturuldu&#x0a;Mu ?" Binding="{Binding SapOrderCreated}" Width="150"/>
                        <DataGridTextColumn Header="Aktif&#x0a;Mi ?" Binding="{Binding IsActive}" Width="90"/>
                        <DataGridTextColumn Header="Oluşturulma&#x0a;Tarihi" Binding="{Binding CreatedDate}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state overlay -->
                <Grid x:Name="EmptyStatePanel"
                      Background="Transparent"
                      Panel.ZIndex="10"
                      IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="108"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1"
                            BorderBrush="#AEB6BF"
                            BorderThickness="1,0,1,1"
                            Background="White">
                        <TextBlock Text="No data available in table"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#333"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,18,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                </StackPanel>

                <TextBlock x:Name="EmptyFooterText"
                           Grid.Column="2"
                           Text="Kayıt Bulunamadı"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           FontSize="16"
                           Foreground="Black"
                           Margin="0,0,0,8"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.Pages.MagazinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1100"
      Title="MagazinePage"
      Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ================= BREADCRUMB ================= -->
        <Border Background="White"
                Padding="15,8"
                BorderBrush="#DCDCDC"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="🏠 Home"
                           Foreground="#1F4E79"
                           FontSize="13"/>

                <TextBlock Text="  >  "
                           Margin="8,0"/>

                <TextBlock Text="Contact"
                           Foreground="#1F4E79"
                           FontSize="13"/>

                <TextBlock Text="  >  "
                           Margin="8,0"/>

                <TextBlock Text="Bosch Corporate Magazine"
                           FontSize="13"
                           FontWeight="SemiBold"/>

            </StackPanel>
        </Border>

        <!-- ================= PAGE TITLE ================= -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">

            <TextBlock Text="Bosch Corporate Magazine"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#2C3E50"/>
        </Border>

        <!-- ================= TAB MENU ================= -->
        <Grid Grid.Row="2"
              Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SOL OK -->
            <Button Grid.Column="0"
                    Width="35"
                    Height="35"
                    Margin="0,0,15,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="❮"
                    FontSize="18"
                    Foreground="Gray"/>

            <!-- TABS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Magazines (Selected) -->
                <StackPanel Margin="0,0,40,0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📰"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Magazines"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Blue Line -->
                    <Border Height="3"
                            Background="#1F77B4"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>


                <!-- My Corporates -->
                <StackPanel Margin="0,0,40,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔗"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="My Corporates"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>


                <!-- Publish -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕"
                                   FontSize="16"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Publish New Magazine"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <!-- SAĞ OK -->
            <Button Grid.Column="2"
                    Width="35"
                    Height="35"
                    Margin="15,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="❯"
                    FontSize="18"
                    Foreground="Black"/>

        </Grid>

        <!-- ================= CONTENT AREA ================= -->
        <Grid Grid.Row="3"
              Background="#F5F6FA">

            <!-- Boş içerik alanı -->
            <TextBlock Text="No magazine records found."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontSize="14"/>

        </Grid>

    </Grid>
</Page>

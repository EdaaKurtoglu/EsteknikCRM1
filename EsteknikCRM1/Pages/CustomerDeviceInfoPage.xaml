<Page x:Class="EsteknikCRM1.Pages.CustomerDeviceInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="CustomerDeviceInfoPage"
      Background="#F3F3F3"
      d:DesignWidth="1600"
      d:DesignHeight="900">

    <Page.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="TabTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="14,10,14,8" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışlar" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışlar İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="8,0,8,18"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="İş Akış Bilgileri"
                       FontSize="22"
                       Foreground="Black"
                       Margin="8,0,8,22"/>

            <!-- Top tabs -->
            <StackPanel Grid.Row="3" Margin="8,0,8,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="38,0,0,0">
                        <TextBlock Text="⇄  İş Akış Bilgileri" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="◷  Eskalasyon Geçmişi" Style="{StaticResource TabTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="◷  İşlem Geçmişi" Style="{StaticResource TabTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="📄  Çözüm Formu" Style="{StaticResource TabTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="🗒  Notlar" Style="{StaticResource TabTextStyle}" VerticalAlignment="Center"/>

                    <Border Grid.Column="3"
                            Height="4"
                            Background="#14A0DB"
                            VerticalAlignment="Bottom"
                            Margin="0,16,0,0"/>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Section title -->
            <Border Grid.Row="4"
                    Background="#D9D9D9"
                    Margin="8,0,8,18"
                    Height="46">
                <TextBlock Text="Çözüm Kaydı Detay"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"
                           FontSize="18"
                           Foreground="#1F2D3D"/>
            </Border>

            <!-- Inner tabs -->
            <StackPanel Grid.Row="5" Margin="8,0,8,18">
                <Grid Margin="0,4,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="❮"
                               FontSize="30"
                               Foreground="#9B9B9B"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="◷  Cihaz Bilgileri"
                               Style="{StaticResource TabTextStyle}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🖥  Müşteri-Cihaz Bilgileri"
                                   Style="{StaticResource TabTextStyle}"/>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="🎟  Dijital Fiş Çıktısı"
                               Style="{StaticResource TabTextStyle}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="5"
                               Text="❯"
                               FontSize="30"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main content -->
            <StackPanel Grid.Row="6" Margin="8,0,8,0">

                <!-- Title bar -->
                <Border Background="#D9D9D9"
                        Height="46"
                        Margin="0,0,0,18">
                    <TextBlock Text="Müşteri ve Cihaz Bilgileri"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               FontSize="18"
                               Foreground="#1F2D3D"/>
                </Border>

                <!-- Customer card -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="760"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="Müşteri Bilgileri"
                              FontSize="15"
                              Padding="8"
                              Height="250"
                              BorderBrush="#BFC5CC">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Adi-Soyadi:"/>
                                    <Run x:Name="CustomerNameText" Text="KEREM REYHAN"/>
                                </TextBlock>

                                <TextBlock Text="Adres:" FontSize="16"/>
                                <TextBlock x:Name="CustomerAddressText"
                                           Text="AKDAM MAH.,AŞAĞI MAH KAYSERİ CAD, Apartman:NO 9, Daire:- Hacılar/Kayseri, Türkiye"
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,8"/>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Tel:"/>
                                    <Run x:Name="CustomerPhoneText" Text="5449486071"/>
                                </TextBlock>

                                <TextBlock FontSize="16">
                                    <Run Text="E-Posta:"/>
                                    <Run x:Name="CustomerEmailText" Text="-"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Content="🗎 Güncelle"
                                    Width="128"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource BlueButtonStyle}"
                                    Click="UpdateCustomerButton_Click"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Toolbar -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4">
                        <TextBlock Text="Hızlı Arama"
                                   FontSize="16"
                                   Foreground="Black"
                                   Margin="0,0,28,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Kayıt Ara"
                                       FontSize="16"
                                       Foreground="#9E9E9E"
                                       Margin="0,0,0,8"/>
                            <Border Width="170"
                                    BorderBrush="#C9CDD2"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Device Grid -->
                <DataGrid x:Name="CustomerDeviceGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="64"
                          RowHeight="70"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinHeight="300">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="130"/>
                        <DataGridTextColumn Header="Cihaz Id" Binding="{Binding DeviceId}" Width="130"/>
                        <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNo}" Width="360"/>
                        <DataGridTextColumn Header="Ürün Adi" Binding="{Binding ProductName}" Width="140"/>
                        <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" Width="170"/>
                        <DataGridTextColumn Header="Çalıştırma Tarihi" Binding="{Binding CommissionDate}" Width="190"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="150"/>

                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="İşlem"
                                            Width="72"
                                            Height="40"
                                            Background="#005A9E"
                                            Foreground="White"
                                            BorderBrush="#005A9E"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="OperationButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="7" Margin="8,18,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Güncelle"
                        Width="106"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="UpdateButton_Click"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,24,0">
                    <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Vertical"
                            HorizontalAlignment="Right">
                    <TextBlock Text="1/1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0,0,0,14"/>

                    <Button Content="🗎 Cihaz Ekle"
                            Width="142"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="AddDeviceButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.StockActionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StockActionPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== BREADCRUMB ===================== -->
        <TextBlock Grid.Row="0"
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0 0 0 15">
            🏠 Home  >  Operations  >  
            <Run Text="Stock Action"
                 Foreground="#1565C0"
                 FontWeight="Bold"/>
        </TextBlock>


        <!-- ===================== HEADER AREA ===================== -->
        <Grid Grid.Row="1" Margin="0 0 0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Text="Service List"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- Search -->
            <TextBox Grid.Column="1"
                     Height="35"
                     VerticalContentAlignment="Center"
                     Padding="10"
                     FontSize="14"/>
        </Grid>


        <!-- ===================== DATA SECTION ===================== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                Padding="10">

            <StackPanel>

                <!-- Export Buttons -->
                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 10">
                    <Button Content="Copy" Margin="0 0 5 0"/>
                    <Button Content="CSV" Margin="0 0 5 0"/>
                    <Button Content="Excel" Margin="0 0 5 0"/>
                    <Button Content="PDF" Margin="0 0 5 0"/>
                    <Button Content="Print"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="StockDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F3F6FA"
                          RowBackground="White"
                          GridLinesVisibility="Horizontal"
                          RowHeight="45">

                    <!-- Hover -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding Id}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Service Title"
                                            Binding="{Binding ServiceTitle}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Service Type"
                                            Binding="{Binding ServiceType}"
                                            Width="150"/>

                        <DataGridTextColumn Header="City"
                                            Binding="{Binding City}"
                                            Width="120"/>

                        <DataGridTextColumn Header="District"
                                            Binding="{Binding District}"
                                            Width="120"/>

                        <!-- SELECT BUTTON -->
                        <DataGridTemplateColumn Header=""
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Select"
                                            Width="80"
                                            Height="28"
                                            Background="#1565C0"
                                            Foreground="White"
                                            Click="Select_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>
        </Border>


        <!-- ===================== PAGINATION ===================== -->
        <Grid Grid.Row="3"
              Margin="0 15 0 0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Arrow -->
            <TextBlock Grid.Column="0"
                       Text="‹"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 10 0"/>

            <!-- Page Number -->
            <Border Grid.Column="1"
                    Width="35"
                    Height="35"
                    CornerRadius="20"
                    Background="#1565C0"
                    HorizontalAlignment="Center">

                <TextBlock Text="1"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Right Arrow -->
            <TextBlock Grid.Column="2"
                       Text="›"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="10 0 0 0"/>

        </Grid>

    </Grid>
</Page>

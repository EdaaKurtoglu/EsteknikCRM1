<Page x:Class="EsteknikCRM1.StockActionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:EsteknikCRM1"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1600"
      Title="StockActionPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OperationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BREADCRUMB -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⌂ Anasayfa"
                       Foreground="#9AA8B6"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  >  "
                       Foreground="#9AA8B6"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock Text="İşlemler"
                       Foreground="#9AA8B6"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  >  "
                       Foreground="#9AA8B6"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Stok Hareketleri"
                       Foreground="#0A67B2"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- MAVİ ÇİZGİ -->
        <Border Grid.Row="1"
                Background="#0A67B2"
                Height="2"
                Margin="0,0,0,22"/>

        <!-- BAŞLIK + SEARCH -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="760"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Servis Listesi"
                       FontSize="22"
                       FontWeight="Normal"
                       Foreground="Black"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Ara"
                           Foreground="#9E9E9E"
                           FontSize="18"
                           Margin="14,0,0,8"/>
                <Border BorderBrush="#BFC5CC"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>
        </Grid>

        <!-- ÜST TOOLBAR -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- EXPORT BUTTONS -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
            </StackPanel>

            <!-- HIZLI ARAMA -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4">
                <TextBlock Text="Hızlı Arama"
                           FontSize="16"
                           Foreground="Black"
                           Margin="0,0,28,0"
                           VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Kayıt Ara"
                               FontSize="16"
                               Foreground="#9E9E9E"
                               Margin="0,0,0,8"/>
                    <Border Width="155"
                            BorderBrush="#C9CDD2"
                            BorderThickness="0,0,0,1"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- TABLE -->
        <Border Grid.Row="4"
                Background="Transparent"
                BorderBrush="#AEB6BF"
                BorderThickness="0">

            <DataGrid x:Name="StockDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="64"
                      RowHeight="72"
                      FontSize="16"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      Margin="0">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F8FC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding Id}"
                                        Width="75"/>

                    <DataGridTextColumn Header="Servis Ünvanı"
                                        Binding="{Binding ServiceTitle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Servis Türü"
                                        Binding="{Binding ServiceType}"
                                        Width="165"/>

                    <DataGridTextColumn Header="Şehir"
                                        Binding="{Binding City}"
                                        Width="110"/>

                    <DataGridTextColumn Header="İlçe"
                                        Binding="{Binding District}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header=""
                                            Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="İşlem"
                                        Style="{StaticResource OperationButtonStyle}"
                                        Click="Select_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- PAGINATION -->
        <Grid Grid.Row="5" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="‹"
                        Style="{StaticResource PagerTextButtonStyle}"/>

                <Border Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="#005A9E"
                        Margin="10,0">
                    <TextBlock Text="1"
                               Foreground="White"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Content="›"
                        Style="{StaticResource PagerTextButtonStyle}"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="1/1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="Black"/>
        </Grid>
    </Grid>
</Page>
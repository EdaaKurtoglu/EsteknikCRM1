<Page x:Class="EsteknikCRM1.Pages.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="AppointmentPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LineTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TodayButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Background" Value="#BDBDBD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HourCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="#F7F7F7"/>
        </Style>

        <Style x:Key="DayCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="#ECECEC"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,8" MinWidth="1550">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Randevu İşlem"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,14"/>

            <!-- Filter panel -->
            <Border Grid.Row="2"
                    BorderBrush="#D0D5DA"
                    BorderThickness="1"
                    Background="Transparent"
                    Margin="0,0,0,18">

                <StackPanel>

                    <!-- Top bar -->
                    <Border Background="#E8E8E8" Height="50">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="⌃"
                                       Foreground="#0A67B2"
                                       FontSize="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Filtreleri Gizle"
                                       Foreground="#0A67B2"
                                       FontSize="16"
                                       Margin="0,0,34,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="◌"
                                       Foreground="#0A67B2"
                                       FontSize="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Filtreleri Sıfırla"
                                       Foreground="#0A67B2"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <Grid Margin="36,28,36,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Service -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Servis"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="ServiceTextBox"
                                             Grid.Column="0"
                                             Text="ES İKLİMLENDİRME VE OTOMASYON SİSTEMLERİ OTOMOTİV T,"
                                             Style="{StaticResource LineTextBoxStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="⌕"
                                               FontSize="26"
                                               Foreground="#B5B5B5"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Team -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Servis Ekibi"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="ServiceTeamComboBox"
                                          Style="{StaticResource LineComboBoxStyle}">
                                    <ComboBoxItem Content="Lütfen seçiniz..."/>
                                    <ComboBoxItem Content="Ekip 1"/>
                                    <ComboBoxItem Content="Ekip 2"/>
                                    <ComboBoxItem Content="Ekip 3"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom -->
                        <Grid Grid.Row="1" Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⌃"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="Filtreleri Gizle"
                                           Foreground="#0A67B2"
                                           FontSize="16"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="⎘ Verileri Yenile"
                                    Width="145"
                                    Style="{StaticResource BlueButtonStyle}"
                                    Click="RefreshButton_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Calendar header -->
            <Grid Grid.Row="3" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left controls -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="‹"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,2,0"/>
                    <Button Content="›"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,12,0"/>
                    <Button Content="bugün"
                            Style="{StaticResource TodayButtonStyle}"
                            Margin="0,0,12,0"/>
                    <Button Content="+"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- Center title -->
                <TextBlock Grid.Column="1"
                           Text="23 – 29 Mar 2026"
                           FontSize="26"
                           Foreground="#1F2D3D"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Right mode buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Hafta"
                            Style="{StaticResource ModeButtonStyle}"
                            Margin="0,0,2,0"/>
                    <Button Content="Gün"
                            Style="{StaticResource ModeButtonStyle}"
                            Margin="0,0,2,0"/>
                    <Button Content="Ajanda"
                            Style="{StaticResource ModeButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Calendar -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Day headers -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1,1,1,1" Background="#F8F8F8">
                        <TextBlock Text="Tüm gün"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#F8F8F8">
                        <TextBlock Text="23/03 Pzt"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#F2EEDB">
                        <TextBlock Text="24/03 Sal"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="3" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#F8F8F8">
                        <TextBlock Text="25/03 Çar"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="4" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#F8F8F8">
                        <TextBlock Text="26/03 Per"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="5" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#F8F8F8">
                        <TextBlock Text="27/03 Cum"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="6" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#E6E8EB">
                        <TextBlock Text="28/03 Cmt"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="7" BorderBrush="#D0D0D0" BorderThickness="0,1,1,1" Background="#E6E8EB">
                        <TextBlock Text="29/03 Paz"
                                   Foreground="#2B78C5"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Time grid -->
                <Grid Grid.Row="1" Height="1450">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                        <ColumnDefinition Width="208"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hour rows -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>

                    <!-- Hour labels -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="00" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="01" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="02" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="03" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="04" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="05" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="06" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="07" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="08" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="09" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="10" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="11" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="12" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="12" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="13" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="13" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="14" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="14" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="15" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="15" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="16" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="16" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="17" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="17" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="18" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="18" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="19" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="19" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="20" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="20" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="21" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <TextBlock Text="21" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    </Border>
                    <Border Grid.Row="22" Grid.Column="0" Style="{StaticResource HourCellBorderStyle}">
                        <Grid>
                            <TextBlock Text="22" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                            <Polygon Points="8,40 16,46 8,52" Fill="Red" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- Day cells -->
                    <!-- Monday -->
                    <Border Grid.Column="1" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#ECECEC"/>
                    <!-- Tuesday -->
                    <Border Grid.Column="2" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#F2EEDB"/>
                    <!-- Wednesday -->
                    <Border Grid.Column="3" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#ECECEC"/>
                    <!-- Thursday -->
                    <Border Grid.Column="4" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#ECECEC"/>
                    <!-- Friday -->
                    <Border Grid.Column="5" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#ECECEC"/>
                    <!-- Saturday -->
                    <Border Grid.Column="6" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#E2E5E8"/>
                    <!-- Sunday -->
                    <Border Grid.Column="7" Grid.RowSpan="23" BorderBrush="#D0D0D0" BorderThickness="0,0,1,1" Background="#E2E5E8"/>

                    <!-- Horizontal hour lines -->
                    <Grid Grid.Column="1" Grid.ColumnSpan="7" Grid.RowSpan="23" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="3" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="5" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="6" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="7" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="9" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="10" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="11" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="12" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="13" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="14" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="15" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="16" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="17" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="18" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="19" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="20" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="21" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"/>
                        <Border Grid.Row="22" BorderBrush="Red" BorderThickness="0,0,0,2"/>
                    </Grid>

                    <!-- Appointment cards -->
                    <!-- Tue 10:00 -->
                    <Border Grid.Column="2" Grid.Row="10"
                            Margin="4,6,4,2"
                            Background="#B9D6E7"
                            BorderBrush="#F0B21A"
                            BorderThickness="4,0,0,0"
                            Height="54"
                            VerticalAlignment="Top">
                        <StackPanel Margin="4,2,4,2">
                            <TextBlock Text="9:55 - 10:55" FontSize="12"/>
                            <TextBlock Text="SEMİH SEVİM" FontSize="14"/>
                            <TextBlock Text="İs Akıs Randevu" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Wed 10:00 -->
                    <Border Grid.Column="3" Grid.Row="10"
                            Margin="4,18,104,2"
                            Background="#B9D6E7"
                            BorderBrush="#F0B21A"
                            BorderThickness="4,0,0,0"
                            Height="54"
                            VerticalAlignment="Top">
                        <StackPanel Margin="4,2,4,2">
                            <TextBlock Text="10:23 - 11:23" FontSize="12"/>
                            <TextBlock Text="İş Akış" FontSize="14"/>
                            <TextBlock Text="Randevu" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Grid.Row="10"
                            Margin="108,18,4,2"
                            Background="#B9D6E7"
                            BorderBrush="#F0B21A"
                            BorderThickness="4,0,0,0"

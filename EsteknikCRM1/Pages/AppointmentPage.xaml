<Page x:Class="EsteknikCRM1.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Breadcrumb -->
            <RowDefinition Height="Auto"/>
            <!-- Filter -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation -->
            <RowDefinition Height="*"/>
            <!-- Calendar -->
        </Grid.RowDefinitions>

        <!-- ===================== BREADCRUMB ===================== -->
        <TextBlock Grid.Row="0"
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0 0 0 15">
            🏠 Home  >  Operations  >  
            <Run Text="Appointment Operation" 
                 Foreground="#1565C0"
                 FontWeight="Bold"/>
        </TextBlock>


        <!-- ===================== FILTER CARD ===================== -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20"
                CornerRadius="6"
                Margin="0 0 0 15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Service -->
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Service" 
                               FontSize="12"
                               Foreground="Gray"/>
                    <TextBox Height="32"/>
                </StackPanel>

                <!-- Service Team -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Service Team"
                               FontSize="12"
                               Foreground="Gray"/>
                    <ComboBox Height="32"
                              SelectedIndex="-1">
                        <ComboBoxItem Content="Please select..."/>
                    </ComboBox>
                </StackPanel>

                <!-- Button -->
                <Button Grid.Column="2"
                        Content="🔄 Refresh Data"
                        Height="32"
                        Background="#1565C0"
                        Foreground="White"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>


        <!-- ===================== WEEK NAVIGATION ===================== -->
        <Grid Grid.Row="2" Margin="0 0 0 15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Buttons -->
            <StackPanel Orientation="Horizontal">

                <Button Content="‹" Width="40" Height="35"/>
                <Button Content="›" Width="40" Height="35" Margin="5,0"/>
                <Button Content="today" Width="70" Height="35" Margin="5,0"/>
                <Button Content="+" Width="40" Height="35" Margin="5,0"/>
            </StackPanel>

            <!-- Date Title -->
            <TextBlock Grid.Column="1"
                       Text="Feb 16 – 22, 2026"
                       FontSize="22"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>

            <!-- Right View Buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button Content="week" Width="60" Height="35"/>
                <Button Content="day" Width="60" Height="35" Margin="5,0"/>
                <Button Content="list" Width="60" Height="35"/>
            </StackPanel>

        </Grid>


        <!-- ===================== CALENDAR GRID ===================== -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                BorderBrush="#DDD"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                <Grid>

                    <!-- 8 Columns (1 time + 7 days) -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- 25 Rows (Header + 24 hours) -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <!-- Hours -->
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <!-- Day Headers -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Mon 2/16" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Tue 2/17" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Wed 2/18" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Thu 2/19" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Fri 2/20" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Sat 2/21" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="7" Text="Sun 2/22" HorizontalAlignment="Center"/>

                    <!-- Sample Time Labels -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="12 AM" Margin="5"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="1 AM" Margin="5"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="2 AM" Margin="5"/>

                </Grid>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>

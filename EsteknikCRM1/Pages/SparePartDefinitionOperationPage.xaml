<Page x:Class="EsteknikCRM1.Pages.SparePartDefinitionOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="SparePartDefinitionOperationPage">

    <Page.Resources>
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ReadOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
        </Style>

        <Style x:Key="TabTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Tanımlar" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Yedek Parça Tanımları" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Yedek Parça Tanımları İşlem"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Yedek Parça İşlemleri"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,26">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="32,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘"
                                       FontSize="24"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Yedek Parça Bilgileri"
                                       Style="{StaticResource TabTextStyle}"/>
                        </StackPanel>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main content -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="760"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="760"/>
                </Grid.ColumnDefinitions>

                <!-- Left -->
                <StackPanel Grid.Column="0" Margin="12,0,0,0">

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Yedek Parça Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Yedek Parça Kodu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="SparePartCodeTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Yedek Parça Adı(TR)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="SparePartNameTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Kdv"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="VatTextBox"
                             Text="%0"
                             Style="{StaticResource FieldValueStyle}"
                             Foreground="#B5B5B5"
                             Margin="0,0,0,38"/>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Garanti Süresi Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Garanti Süresi(Ay)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="WarrantyTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>
                </StackPanel>

                <!-- Right -->
                <StackPanel Grid.Column="2">

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Phase Out Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <CheckBox x:Name="PhaseOutCheckBox"
                              Content="Phase Out"
                              FontSize="18"
                              Margin="0,0,0,22"/>

                    <TextBlock Text="Phase Out Tarihi"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="PhaseOutDatePicker"
                                    Grid.Column="0"
                                    Height="38"
                                    FontSize="16"
                                    BorderBrush="#BFBFBF"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent"
                                    Foreground="#B5B5B5"/>

                        <TextBlock Grid.Column="1"
                                   Text="📅"
                                   FontSize="22"
                                   Foreground="#B5B5B5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Diğer Bilgiler"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Tedarikçi"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="SupplierTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="B Kodu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BCodeTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource FieldValueStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchBCodeButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="⊘ Vazgeç"
                        Width="110"
                        Margin="0,0,12,0"
                        Style="{StaticResource OutlineBlueButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="💾 Kaydet"
                        Width="96"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.Pages.HakedisSetDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9" Height="651">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Hakediş Set Detayı"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <DataGrid x:Name="OperationsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowId}" Width="160"/>
                <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNumber}" Width="180"/>
                <DataGridTextColumn Header="Stok Kodu" Binding="{Binding StockCode}" Width="120"/>
                <DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="220"/>
                <DataGridTextColumn Header="İşçilik Kodu" Binding="{Binding LaborCode}" Width="110"/>
                <DataGridTextColumn Header="İşçilik" Binding="{Binding LaborName}" Width="200"/>
                <DataGridTextColumn Header="Fiyat" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Adet" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Toplam" Binding="{Binding TotalAmount}" Width="120"/>
                <DataGridTextColumn Header="Ödeme Tipi" Binding="{Binding CustomerOrCenterPay}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="← Geri"
                Width="100"
                Height="38"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Click="BackButton_Click"/>
    </Grid>
</Page>
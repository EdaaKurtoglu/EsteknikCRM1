<Page x:Class="EsteknikCRM1.WorkflowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:EsteknikCRM1"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1200"
      Title="WorkflowPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WorkflowRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="30" Height="30" Margin="0,0,12,0">
                                <Ellipse x:Name="OuterCircle"
                                         Fill="#D9D9D9"
                                         Width="30"
                                         Height="30"/>
                                <Ellipse x:Name="InnerCircle"
                                         Fill="Transparent"
                                         Width="12"
                                         Height="12"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="Fill" Value="#005A9E"/>
                                <Setter TargetName="InnerCircle" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="10" MinWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışlar" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="İş Akış Kayıtları"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,18"/>

            <!-- Search + add -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="760"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ara"
                                       Foreground="#9E9E9E"
                                       FontSize="18"
                                       Margin="14,0,0,8"/>
                            <TextBox x:Name="SearchTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="18"
                                     Padding="14,0,0,0"/>
                            <Border BorderBrush="#BFC5CC"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Button Grid.Row="1"
                            Content="+ Yeni İş Akışı Oluştur"
                            Width="196"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="NewWorkflow_Click"/>
                </Grid>
            </Grid>

            <!-- Filter panel -->
            <!-- Filter panel -->
            <Border Grid.Row="4"
        Background="White"
        BorderBrush="#D9D9D9"
        BorderThickness="1"
        Margin="0,0,0,18">

                <StackPanel>
                    <!-- Filter header -->
                    <Border Background="#E8E8E8"
                Height="50">
                        <Grid Margin="18,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="FilterToggleIconTop"
                           Text="⌃"
                           Foreground="#0A67B2"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                        x:Name="FilterToggleButtonTop"
                        Content="Filtreleri Gizle"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#0A67B2"
                        FontSize="14"
                        Padding="10,0,10,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="FilterToggleButton_Click"/>

                            <TextBlock Grid.Column="3"
                           Text="◌"
                           Foreground="#0A67B2"
                           FontSize="14"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                            <Button Grid.Column="4"
                        Content="Filtreleri Sıfırla"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#0A67B2"
                        FontSize="14"
                        Padding="0"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="ClearFiltersButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- FILTER CONTENT -->
                    <StackPanel x:Name="FilterContentPanel"
                    Margin="22,18,22,14"
                    Visibility="Visible">

                        <!-- Radios -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="AssignedToPersonRadioButton"
                             Grid.Column="0"
                             Content="Kişiye Atananlar"
                             Style="{StaticResource WorkflowRadioStyle}"
                             Margin="16,0,0,0"/>

                            <RadioButton x:Name="WaitingOnMeRadioButton"
                             Grid.Column="1"
                             Content="Üstümde bekleyenler"
                             Style="{StaticResource WorkflowRadioStyle}"
                             IsChecked="True"
                             Margin="16,0,0,0"/>

                            <RadioButton x:Name="LiveFlowRadioButton"
                             Grid.Column="2"
                             Content="Canlı akış"
                             Style="{StaticResource WorkflowRadioStyle}"
                             Margin="16,0,0,0"/>

                            <RadioButton x:Name="CompletedRadioButton"
                             Grid.Column="3"
                             Content="Tamamlanmışlar"
                             Style="{StaticResource WorkflowRadioStyle}"
                             Margin="16,0,0,0"/>

                            <RadioButton x:Name="RejectedRadioButton"
                             Grid.Column="4"
                             Content="Reddedilenler"
                             Style="{StaticResource WorkflowRadioStyle}"
                             Margin="16,0,0,0"/>
                        </Grid>

                        <!-- Inputs -->
                        <Grid Margin="16,0,16,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Müşteri Adi"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                                <TextBox x:Name="CustomerNameFilterTextBox"
                             Style="{StaticResource FlatTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Müşteri Soyadi"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                                <TextBox x:Name="CustomerSurnameFilterTextBox"
                             Style="{StaticResource FlatTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Telefon"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                                <TextBox x:Name="PhoneFilterTextBox"
                             Style="{StaticResource FlatTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Footer filter -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                <TextBlock x:Name="FilterToggleIconBottom"
                               Text="⌃"
                               Foreground="#0A67B2"
                               FontSize="14"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                                <Button x:Name="FilterToggleButtonBottom"
                            Content="Filtreleri Gizle"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#0A67B2"
                            FontSize="14"
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Click="FilterToggleButton_Click"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                        Content="⛃ Verileri Yenile"
                        Width="148"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="RefreshDataButton_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="14"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="14"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="155"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Grid.Row="6"
                      x:Name="WorkflowGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="88"
                      RowHeight="96"
                      FontSize="14"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MinHeight="520">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,8,10,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="95"/>
                    <DataGridTextColumn Header="İş Akışı&#x0a;Durumu" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Akış&#x0a;Tipi" Binding="{Binding FlowType}" Width="90"/>
                    <DataGridTextColumn Header="Son Yapılan&#x0a;İşlem" Binding="{Binding LastAction}" Width="155"/>
                    <DataGridTextColumn Header="Konu" Binding="{Binding Subject}" Width="310"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="165"/>
                    <DataGridTextColumn Header="Müşteri&#x0a;Telefon" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="Oluşturulma&#x0a;Tarihi" Binding="{Binding CreatedDate}" Width="160"/>
                    <DataGridTemplateColumn Header="Oluşturan&#x0a;Kişi" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding CreatedBy}"
                                               Foreground="#005A9E"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CreatedRole}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Başlangıç&#x0a;Tipi" Binding="{Binding StartType}" Width="130"/>

                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="İşlem"
                                        Width="72"
                                        Height="40"
                                        Background="#005A9E"
                                        Foreground="White"
                                        BorderBrush="#005A9E"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pagination -->
            <Grid Grid.Row="7" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹"
                            Style="{StaticResource PagerButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="›"
                            Style="{StaticResource PagerButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="1/1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="Black"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
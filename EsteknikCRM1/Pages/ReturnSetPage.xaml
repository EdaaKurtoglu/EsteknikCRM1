<Page x:Class="EsteknikCRM1.Pages.ReturnSetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="ReturnSetPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="TopBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="14,10,14,8" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İade İşlemleri" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="8,0,8,20"/>

            <!-- Title -->
            <Grid Grid.Row="2" Margin="8,0,8,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="İade Setleri"
                           FontSize="22"
                           Foreground="Black"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+ İade Seti Oluştur"
                        Width="172"
                        Style="{StaticResource TopBlueButtonStyle}"
                        Click="CreateReturnSet_Click"/>
            </Grid>

            <!-- Checkbox + upper buttons -->
            <Grid Grid.Row="3" Margin="8,0,8,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Content="Onay Bekleyenler"
                          FontSize="16"
                          Margin="0,6,0,18"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="≣ Tüm İade Setleri"
                            Width="170"
                            Margin="0,0,14,0"
                            Style="{StaticResource TopBlueButtonStyle}"/>
                    <Button Content="≣ Onaylanmış Setler"
                            Width="182"
                            Margin="0,0,14,0"
                            Style="{StaticResource TopBlueButtonStyle}"/>
                    <Button Content="≣ Onay Bekleyen Setler"
                            Width="206"
                            Margin="0,0,14,0"
                            Style="{StaticResource TopBlueButtonStyle}"/>
                    <Button Content="≣ Listele"
                            Width="98"
                            Style="{StaticResource TopBlueButtonStyle}"
                            Click="ListButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <StackPanel Grid.Row="4" Margin="8,0,8,18">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="❮"
                               FontSize="34"
                               Foreground="#B7B7B7"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="⌂  Garantiden Yedek Parça İade Seti"
                                   FontSize="16"
                                   Foreground="#1F2D3D"/>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="⌂  Garantiden Ürün Değişimi İade Seti"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3"
                               Text="⌂  EWL İade Seti"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="4"
                               Text="⌂  Ek Garantiden Yedek Parça İade Seti"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="5"
                               Text="⌂  Goodwill D"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="6"
                               Text="❯"
                               FontSize="34"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="5" Margin="8,0,8,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="160"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Table + pager -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          x:Name="ReturnSetGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="72"
                          RowHeight="108"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinHeight="560">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="İade Set&#x0a;Türü" Binding="{Binding ReturnSetType}" Width="180"/>
                        <DataGridTextColumn Header="İade&#x0a;Süreç&#x0a;Tipi" Binding="{Binding ProcessType}" Width="120"/>
                        <DataGridTextColumn Header="Servis Adı" Binding="{Binding ServiceName}" Width="400"/>
                        <DataGridTextColumn Header="Akış&#x0a;Numarası" Binding="{Binding FlowNumber}" Width="150"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="140"/>
                        <DataGridTextColumn Header="Tamamlandı" Binding="{Binding Completed}" Width="150"/>
                        <DataGridTextColumn Header="Set Tarihi" Binding="{Binding SetDate}" Width="170"/>
                        <DataGridTextColumn Header="İade&#x0a;Kalem&#x0a;Sayısı" Binding="{Binding ItemCount}" Width="140"/>

                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="İşlem"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Margin="0,26,0,0"
                                            Click="OperationButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="İptal"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Margin="0,26,0,0"
                                            Click="CancelSetButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#005A9E"
                                Margin="10,0">
                            <TextBlock Text="1"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="1/1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Black"/>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
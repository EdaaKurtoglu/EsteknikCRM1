<Page x:Class="EsteknikCRM1.Pages.WorkflowOperationDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="WorkflowOperationDetailPage">

    <Page.Resources>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8A8F96"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FlatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LineContainerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GreenOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#7CB342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RedOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A3F78"/>
            <Setter Property="BorderBrush" Value="#0A3F78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="16,10,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışlar" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İş Akışları İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,18"/>

            <!-- Title + Tabs -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <TextBlock Text="İş Akış Bilgileri"
                           FontSize="22"
                           Foreground="Black"
                           Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" Margin="36,6,0,16">
                    <StackPanel Margin="0,0,24,0">
                        <Button Content="⥮  İş Akış Bilgileri"
                                Style="{StaticResource TabButtonStyle}"/>
                        <Border Height="4" Background="#14A0DB" Margin="8,10,8,0"/>
                    </StackPanel>

                    <Button Content="◷  Eskalasyon Geçmişi"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="◴  İşlem Geçmişi"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="📄  Çözüm Formu"
                            Style="{StaticResource TabButtonStyle}"
                            Margin="0,0,18,0"/>

                    <Button Content="📝  Notlar"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main content -->
            <StackPanel Grid.Row="3">

                <Border Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Text="İş Akış Formu Bilgileri"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="15"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <StackPanel Grid.Column="0">

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="İş Akış Bilgileri"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="16"/>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="İş Akış Numarası" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Style="{StaticResource LineContainerStyle}">
                                    <TextBlock x:Name="workflowNumber" Text="2838407" Style="{StaticResource FlatValueStyle}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Oluşturulma Tarihi" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Style="{StaticResource LineContainerStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock  x:Name="createdDate" Text="25/03/2026" Style="{StaticResource FlatValueStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="🗓"
                                                   FontSize="22"
                                                   Foreground="#B3B3B3"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Hakediş Numarası" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource LineContainerStyle}">
                                <TextBlock x:Name="hakedisNumber" Text="" Style="{StaticResource FlatValueStyle}"/>
                            </Border>
                        </StackPanel>

                        <Border Background="#E7E7E7" Padding="16" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="46" Background="White" CornerRadius="23" Margin="0,0,12,0">
                                    <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="companyName" Text="NETİSA MÜHENDİSLİK"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="role" Text="Ofis Çalışanı" FontSize="15"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Devreye Alma Formu"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   Margin="0,10,0,18"/>

                        <GroupBox Header="Devreye Alma Bilgileri" Margin="0,0,0,18">
                            <StackPanel Margin="8">

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Kategori: "/>
                                    <Run x:Name="CategoryText" Text="Devreye Alma"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Bildirim Tipi: "/>
                                    <Run x:Name="NotificationTypeText" Text="Servis Talebi"/>
                                </TextBlock>

                                <TextBlock FontSize="16">
                                    <Run Text="Alt Kategori: "/>
                                    <Run x:Name="SubCategoryText" Text="Devreye Alma Talebi"/>
                                </TextBlock>

                            </StackPanel>
                        </GroupBox>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Geliş Kanalı" Style="{StaticResource FieldLabelStyle}" Foreground="Black"/>
                            <TextBlock Text="Cihazın Satın Alındığı Yer" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource LineContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bayi" Style="{StaticResource FlatValueStyle}" Foreground="#B5B5B5"/>
                                    <TextBlock Grid.Column="1" Text="⌄" FontSize="18" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Devreye Alınan Cihazın Durumu" Style="{StaticResource FieldLabelStyle}" Foreground="Black"/>
                            <Border Style="{StaticResource LineContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lütfen seçiniz..." Style="{StaticResource FlatValueStyle}"/>
                                    <TextBlock Grid.Column="1" Text="⌄" FontSize="18" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Bildirim Açıklaması" Style="{StaticResource FieldLabelStyle}" Foreground="Black"/>
                            <Border Style="{StaticResource LineContainerStyle}" MinHeight="130">
                                <TextBlock Text="Devreye alma talebi" Style="{StaticResource FlatValueStyle}" Margin="0,6,0,0"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="Bayi Bilgileri"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="16"/>
                        </Border>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Bayi" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource LineContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="bayi" Text="NETİSA MÜHENDİSLİK SANAYİ VE"
                                               Style="{StaticResource FlatValueStyle}"
                                               Foreground="#C0C0C0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="⌕"
                                               FontSize="24"
                                               Foreground="#9A9A9A"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border BorderBrush="#C7CDD4" BorderThickness="1" Padding="10" Margin="0,0,0,18">
                            <TextBlock Text="Bayi:" FontSize="15"/>
                        </Border>

                        <GroupBox Header="Servis Bilgileri" Margin="0,0,0,18">
                            <StackPanel Margin="8">
                                <TextBlock Text="Servis:" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock x:Name="serviceName" Text="ES İKLİMLENDİRME VE OTOMASYON SİSTEMLERİ OTOMOTİV TAAHHÜT HAYVANCILIK SAN. TİC. LTD. ŞTİ."
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Servis Takım:-" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Hizmet Tarihi:" FontSize="16"/>
                            </StackPanel>
                        </GroupBox>

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="Diğer Bilgileri"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="16"/>
                        </Border>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Tercih edilen yanıtlama kanalı" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Style="{StaticResource LineContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="" Style="{StaticResource FlatValueStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="⌕"
                                               FontSize="24"
                                               Foreground="#9A9A9A"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Ek Açıklama" Style="{StaticResource FieldLabelStyle}" Foreground="Black"/>
                            <Border Style="{StaticResource LineContainerStyle}" MinHeight="110">
                                <TextBlock Text="" Style="{StaticResource FlatValueStyle}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <!-- RIGHT -->
                    <StackPanel Grid.Column="2">

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="Durumu"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="16"/>
                        </Border>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⥮" FontSize="28" Foreground="#7FB51E" Margin="0,0,8,0"/>
                                <TextBlock x:Name="status" Text="Devam Ediyor" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="◴" FontSize="28" Foreground="#7FB51E" Margin="0,0,8,0"/>
                                <TextBlock x:Name="madeTime" Text="Normal" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="Kullanıcılar"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="16"/>
                        </Border>

                        <ItemsControl x:Name="UsersItemsControl" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E7E7E7" Padding="10" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42"
                                                Height="42"
                                                Background="White"
                                                CornerRadius="21"
                                                Margin="0,0,10,0">
                                                <TextBlock Text="👤"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}"
                                                       Foreground="#3C78B6"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"/>
                                                <TextBlock Text="{Binding DisplayRole}"
                                   FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <GroupBox Header="Müşteri Bilgileri" Margin="0,0,0,18">
                            <StackPanel Margin="8">

                                <!-- Ad Soyad -->
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Adi-Soyadi: "/>
                                    <Run x:Name="CustomerNameText" Text="OZAN SPOR SALONU KURTUL"/>
                                </TextBlock>

                                <!-- Adres Başlık -->
                                <TextBlock Text="Adres:" FontSize="16"/>

                                <!-- Adres -->
                                <TextBlock FontSize="16"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,8">
                                <Run x:Name="CustomerAddressText"
                                     Text="MERKEZ,MEHMET AKİF ERSOY MH., Apartman:1110 ADA 66 PARSEL OTAGAR YANI, Daire:1 Merkez/Nevşehir, Türkiye"/>
                                </TextBlock>

                                <!-- Telefon -->
                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Tel: "/>
                                    <Run x:Name="CustomerPhoneText" Text="5334665505"/>
                                </TextBlock>

                                <!-- Email -->
                                <TextBlock FontSize="16" Margin="0,0,0,10">
                                    <Run Text="E-Posta: "/>
                                    <Run x:Name="CustomerEmailText" Text="-"/>
                                </TextBlock>

                                <!-- Buton -->
                                <Button Content="🗎 Güncelle"
                                    Width="130"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BlueButtonStyle}"
                                    Click="UpdateCustomer_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Margin="0,0,0,18">

                            <TextBlock Text="Müşteri Proje"
                               Style="{StaticResource FieldLabelStyle}"
                               Foreground="Black"/>

                            <Border Style="{StaticResource LineContainerStyle}">

                                <ComboBox x:Name="CustomerProjectComboBox"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="16"
                                      Height="36"
                                      Padding="0"
                                      SelectionChanged="CustomerProjectComboBox_SelectionChanged">

                                    <!-- Default -->
                                    <ComboBoxItem Content="Lütfen seçiniz..." IsSelected="True"/>

                                </ComboBox>

                            </Border>

                        </StackPanel>

                        <GroupBox Header="Cihaz Bilgileri" Margin="0,0,0,18">
                            <StackPanel Margin="8">

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Seri Numarası: "/>
                                    <Run x:Name="DeviceSerialText" Text="86DM4****************"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Ürün Grubu Adı: "/>
                                    <Run x:Name="ProductGroupText" Text="AF4300A 33-3 Kompakt VRF D.Ü. 33kW"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Marka Adı: "/>
                                    <Run x:Name="BrandText" Text="Bosch"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Üst Ürün Grubu Adı: "/>
                                    <Run x:Name="MainProductGroupText" Text="VRF SİSTEMLER"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Devreye Alma Tarihi: "/>
                                    <Run x:Name="CommissionDateText" Text="-"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Garanti Bitiş Tarihi: "/>
                                    <Run x:Name="WarrantyEndDateText" Text="-"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Ek Garanti Bilgisi: "/>
                                    <Run x:Name="ExtraWarrantyText" Text="-"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Genişletilmiş Garanti: "/>
                                    <Run x:Name="ExtendedWarrantyText" Text="Hayır"/>
                                </TextBlock>

                                <TextBlock FontSize="16" Margin="0,0,0,8">
                                    <Run Text="Tesisat Tipi: "/>
                                    <Run x:Name="InstallationTypeText" Text="-"/>
                                </TextBlock>

                                <TextBlock FontSize="16">
                                    <Run Text="Teknisyen Bayi Seçimi: "/>
                                    <Run x:Name="TechnicianSelectionText" Text="-"/>
                                </TextBlock>

                            </StackPanel>
                        </GroupBox>

                       <!-- <GroupBox Header="Cihaz Bilgileri" Margin="0,0,0,18">
                            <StackPanel Margin="8">
                                <TextBlock Text="Seri Numarası:86DM4****************" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Ürün Grubu Adı:AF4300A 40-3 Kompakt VRF D.Ü. 40kW" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Marka Adı:Bosch" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Üst Ürün Grubu Adı:VRF SİSTEMLER" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Devreye Alma Tarihi:" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Garanti Bitiş Tarihi:" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Ek Garanti Bilgisi:" FontSize="16" Margin="0,0,0,8"/>

<Page x:Class="EsteknikCRM1.Pages.EMessagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EMessagePage">

    <Grid Background="#F5F6FA" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Breadcrumb -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Home" Foreground="Gray"/>
            <TextBlock Text="  >  " Foreground="Gray"/>
            <TextBlock Text="Contact" Foreground="Gray"/>
            <TextBlock Text="  >  " Foreground="Gray"/>
            <TextBlock Text="E-Message"
                   FontWeight="SemiBold"
                   Foreground="#1E3A8A"/>
        </StackPanel>

        <!-- 🔹 Header -->
        <TextBlock Grid.Row="1"
               Text="E-Message"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,20,0,20"/>

        <!-- 🔹 Content Card -->
        <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="5"
            Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 🔹 Tab Menu -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Arrow -->
                    <Button Grid.Column="0"
                        Content="❮"
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"/>

                    <!-- Inbox -->
                    <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            Margin="10,0"
                            Cursor="Hand">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📩"
                                   FontSize="14"
                                   Margin="0,0,5,0"/>
                            <TextBlock Text="Inbox"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Active underline -->
                        <Border Height="3"
                            Background="#1E88E5"
                            Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Sentbox -->
                    <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="20,0"
                            Cursor="Hand">
                        <TextBlock Text="📤"
                               FontSize="14"
                               Margin="0,0,5,0"/>
                        <TextBlock Text="Sentbox"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- New Message -->
                    <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="20,0"
                            Cursor="Hand">
                        <TextBlock Text="＋"
                               FontSize="16"
                               Margin="0,0,5,0"/>
                        <TextBlock Text="Sent New E-Message"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Arrow -->
                    <Button Grid.Column="5"
                        Content="❯"
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"/>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1"
                    Margin="0,15,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"/>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="0,40,0,0">
                    <TextBlock Text="You haven't sent any e-message yet."
                           Foreground="Gray"
                           FontSize="14"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>

</Page>

<Page x:Class="EsteknikCRM1.Pages.TeamDefinitionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3">

    <Page.Resources>

        <!-- Export Buttons -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Blue Button -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 🔹 Breadcrumb -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6"/>
                <TextBlock Text=" > Tanımlar" Foreground="#9AA8B6"/>
                <TextBlock Text=" > Ekip Tanımları"
                           Foreground="#0A67B2"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- 🔹 Blue Line -->
            <Border Grid.Row="1" Background="#0A67B2" Height="2"/>

            <!-- 🔹 Title + Button -->
            <Grid Grid.Row="2" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ekip Tanımları"
                           FontSize="22"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+ Yeni Ekip Ekle"
                        Width="160"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="AddTeam_Click"/>
            </Grid>

            <!-- 🔹 Toolbar -->
            <Grid Grid.Row="3" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Copy" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Print" Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <TextBlock Text="Kayıt Filtrele"
                               Margin="0,0,20,0"/>

                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   Foreground="#9E9E9E"/>
                        <Border Width="180"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 🔹 DataGrid -->
            <DataGrid Grid.Row="4"
                      x:Name="TeamGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      RowHeight="80"
                      FontSize="15"
                      SelectionMode="Single">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Servis Adı" Binding="{Binding ServiceName}" Width="400"/>
                    <DataGridTextColumn Header="Ekip Adı" Binding="{Binding TeamName}" Width="150"/>
                    <DataGridTextColumn Header="Üye Sayısı" Binding="{Binding MemberCount}" Width="120"/>

                    <!-- Members -->
                    <DataGridTemplateColumn Header="Ekip Üyeleri" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding MemberName}"
                                               Foreground="#0A67B2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Role}"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/>

                    <!-- Button -->
                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="İşlem"
                                        Width="80"
                                        Height="35"
                                        Background="#005A9E"
                                        Foreground="White"
                                        Click="Select_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- 🔹 Pagination -->
            <Grid Grid.Row="5" Margin="0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="‹" FontSize="20" Margin="10"/>
                    <Border Width="36" Height="36" Background="#005A9E" CornerRadius="18">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="›" FontSize="20" Margin="10"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="1/1"
                           HorizontalAlignment="Right"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.Pages.AnnouncementFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Duyuru Dosyaları"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <DataGrid x:Name="FilesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Boyut" Binding="{Binding FileSize}" Width="120"/>
                <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedDate}" Width="180"/>

                <DataGridTemplateColumn Header="İndir" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="İndir"
                                    Click="DownloadButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="← Geri"
                Width="100"
                Height="38"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Click="BackButton_Click"/>
    </Grid>
</Page>
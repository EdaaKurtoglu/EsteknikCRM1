<Page x:Class="EsteknikCRM1.Pages.FreeMaterialRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="FreeMaterialRequestsPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="0,0,0,10" MinWidth="1550">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,18,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Bedelsiz Malzeme Talepleri" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="18,0,18,24"/>

            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="16,22,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="160"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Grid.Row="3"
                      Margin="0,0,0,0"
                      x:Name="FreeMaterialGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="84"
                      RowHeight="190"
                      FontSize="16"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MinHeight="620">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,10,10,10"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="▶"
                                           Foreground="#6E6E6E"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,74,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="Servis&#x0a;Kodu" Binding="{Binding ServiceCode}" Width="110"/>
                    <DataGridTextColumn Header="Servis İsmi" Binding="{Binding ServiceName}" Width="175"/>
                    <DataGridTextColumn Header="Servis&#x0a;Fişi" Binding="{Binding ServiceReceipt}" Width="110"/>
                    <DataGridTextColumn Header="Servis&#x0a;SAP&#x0a;Kodu" Binding="{Binding ServiceSapCode}" Width="115"/>
                    <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="140"/>
                    <DataGridTextColumn Header="Yedek&#x0a;Parça-&#x0a;Ürün&#x0a;İsmi" Binding="{Binding SparePartProductName}" Width="135"/>
                    <DataGridTextColumn Header="Yedek&#x0a;Parça-&#x0a;Ürün&#x0a;SAP&#x0a;Kodu" Binding="{Binding SparePartProductSapCode}" Width="135"/>
                    <DataGridTextColumn Header="TTSM&#x0a;Sipariş&#x0a;Numarası" Binding="{Binding TtsmOrderNumber}" Width="135"/>
                    <DataGridTextColumn Header="SAP&#x0a;Sipariş&#x0a;Numarası" Binding="{Binding SapOrderNumber}" Width="135"/>
                    <DataGridTextColumn Header="Oluşturulma&#x0a;Tarihi" Binding="{Binding CreatedDate}" Width="170"/>
                    <DataGridTextColumn Header="İş&#x0a;Akış" Binding="{Binding WorkflowNo}" Width="95"/>
                    <DataGridTextColumn Header="Sipariş&#x0a;Türü" Binding="{Binding OrderType}" Width="125"/>
                    <DataGridTextColumn Header="İade&#x0a;Set&#x0a;No" Binding="{Binding ReturnSetNo}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pagination -->
            <Grid Grid.Row="4" Margin="0,18,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="2"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="3"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="4"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="5"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="›"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="22"
                            Margin="10,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="1/5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="Black"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
<Page x:Class="EsteknikCRM1.Pages.IndividualCustomerOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F3F3">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BREADCRUMB -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Anasayfa" Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Kartlar" Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Bireysel Müşteri Kartları" Foreground="#0A67B2" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#7A8A9A" FontSize="14"/>
            <TextBlock Text="Bireysel Müşteri Kart İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- TITLE + TABS -->
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#0A67B2" BorderThickness="0,0,0,2" Margin="0,0,0,18"/>

            <TextBlock Text="Bireysel Müşteri İşlemleri"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,26"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="❮"
                           FontSize="34"
                           Foreground="#B7B7B7"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="⌂  Bireysel Müşteri Bilgileri"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>
                    <Border Height="4"
                            Background="#14A0DB"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="▤  Müşteri Adresleri"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="🗎  Açık Rıza Metinleri"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="4"
                           Text="⇄  MI4Biz Tarihçesi - Talep Formları"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="5"
                           Text="⇄  Devreye Alma Solution Form Alnet Tari"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <TextBlock Grid.Column="6"
                           Text="❯"
                           FontSize="34"
                           Foreground="#000"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,0,0,18"/>
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL -->
                <StackPanel Grid.Column="0">

                    <Border Background="#D9D9D9" Height="44" Margin="0,12,0,18">
                        <TextBlock Text="Müşteri Bilgileri"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Border>

                    <CheckBox Content="VIP"
                              FontSize="16"
                              Margin="0,8,0,22"/>

                    <StackPanel>
                        <TextBlock Text="Müşteri Id" Margin="0,12,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Adı" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="İkinci Adı" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Soyadı" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                    </StackPanel>

                    <Border Background="#D9D9D9" Height="44" Margin="0,40,0,18">
                        <TextBlock Text="Müşteri İletişim Bilgileri"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Tel Numarası" Margin="0,12,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Cep Telefon Numarası" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Tel Numarası(2)" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Cep Telefon Numarası(2)" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                    </StackPanel>

                    <CheckBox Content="E-posta adresi bilinmiyor"
                              FontSize="16"
                              Margin="0,28,0,18"/>

                    <StackPanel>
                        <TextBlock Text="Email Adresi" Margin="0,12,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>

                        <TextBlock Text="Email Adresi(2)" Margin="0,22,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                    </StackPanel>

                    <Border Background="#D9D9D9" Height="44" Margin="0,40,0,18">
                        <TextBlock Text="Diğer Bilgiler"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Border>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Açıklama" Margin="0,12,0,8"/>
                        <TextBox Height="90"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0,0,0,1"
                                 Background="Transparent"/>
                    </StackPanel>

                </StackPanel>

                <!-- SAĞ -->
                <StackPanel Grid.Column="2">

                    <Border Background="#D9D9D9" Height="44" Margin="0,12,0,18">
                        <TextBlock Text="Adres Bilgileri"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ülke" Margin="0,12,0,8"/>
                            <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⌕" FontSize="22" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İl" Margin="0,12,0,8"/>
                            <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⌕" FontSize="22" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İlçe" Margin="0,12,0,8"/>
                            <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⌕" FontSize="22" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Semt" Margin="0,12,0,8"/>
                        <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="Adres" Margin="0,12,0,8"/>
                        <TextBox Height="90"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0,0,0,1"
                                 Background="Transparent"/>
                    </StackPanel>

                    <Border Background="#D9D9D9" Height="44" Margin="0,18,0,18">
                        <TextBlock Text="Müşteri Detay Bilgileri"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Özel Proje Bilgisi" Margin="0,12,0,8"/>
                            <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⌕" FontSize="22" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Yapı Bilgisi" Margin="0,12,0,8"/>
                            <TextBox Height="34" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⌕" FontSize="22" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- BOTTOM BUTTONS -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="⊘ Vazgeç"
                    Width="110"
                    Height="42"
                    Margin="0,0,12,0"
                    Background="White"
                    Foreground="#0A67B2"
                    BorderBrush="#0A67B2"/>

            <Button Content="🗎 Kaydet"
                    Width="110"
                    Height="42"
                    Margin="0,0,12,0"
                    Background="#005A9E"
                    Foreground="White"
                    BorderBrush="#005A9E"/>

            <Button Content="+ Yeni İş Akışı Oluştur"
                    Width="220"
                    Height="42"
                    Background="#005A9E"
                    Foreground="White"
                    BorderBrush="#005A9E"/>
        </StackPanel>
    </Grid>
</Page>
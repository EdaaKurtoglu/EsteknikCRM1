<Page x:Class="EsteknikCRM1.Pages.HakedisRecordDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="HakedisRecordDetailPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A67B2"/>
            <Setter Property="BorderBrush" Value="#0A67B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LineTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
        </Style>

        <Style x:Key="LineValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="12,10,12,8" MinWidth="1450">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Hakediş Kayıtları" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Hakediş Kayıtları İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="8,0,8,18"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Hakediş Kayıtları İşlem"
                       FontSize="22"
                       Margin="8,0,8,22"
                       Foreground="Black"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="8,0,8,18">
                <Grid Margin="0,4,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="38,0,0,0">
                        <TextBlock Text="🏭  Hakediş (Merkez Ödeyecek) Bilgileri"
                                   FontSize="16"
                                   Foreground="#1F2D3D"/>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="🏭  Hakediş (Müşteri Ödeyecek) Bilgileri"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="◷  İşlem Geçmişi"
                               FontSize="16"
                               Foreground="#1F2D3D"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Filter -->
            <StackPanel Grid.Row="4" Margin="0,0,0,14">

                <Border Background="#E8E8E8"
                        BorderBrush="#D0D5DA"
                        BorderThickness="1"
                        Height="50">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="⌃"
                                   Foreground="#0A67B2"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Filtreleri Gizle"
                                   Foreground="#0A67B2"
                                   FontSize="16"
                                   Margin="0,0,34,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="◌"
                                   Foreground="#0A67B2"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Filtreleri Sıfırla"
                                   Foreground="#0A67B2"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#D0D5DA"
                        BorderThickness="1,0,1,1"
                        Padding="36,26,36,18">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Servis Fişi Türü"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource FlatComboBoxStyle}">
                                    <ComboBoxItem Content="Lütfen seçiniz..."/>
                                    <ComboBoxItem Content="İlk Çalıştırma"/>
                                    <ComboBoxItem Content="Garantili İş"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="⎘ Verileri Yenile"
                                    Width="145"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource BlueButtonStyle}"
                                    Click="RefreshButton_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,22,0,0">
                            <TextBlock Text="⌃"
                                       Foreground="#0A67B2"
                                       FontSize="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="Filtreleri Gizle"
                                       Foreground="#0A67B2"
                                       FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Summary sections -->
            <Grid Grid.Row="5" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="Hakediş Bilgileri" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <Grid Margin="18,18,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Hakediş Numarası" Style="{StaticResource LineTextStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="59420" Style="{StaticResource LineValueStyle}"/>
                            <Border BorderBrush="#BFC5CC" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Oluşturulma Tarihi" Style="{StaticResource LineTextStyle}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="23/03/2026"
                                           Style="{StaticResource LineValueStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅"
                                           FontSize="18"
                                           Foreground="#B5B5B5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="#BFC5CC" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,28,0,0">
                            <TextBlock Text="Servis Firma İsmi" Style="{StaticResource LineTextStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="ES İKLİMLENDİRME VE OTOMASYON SİSTEMLERİ OTOMOTİV TAAHHÜT"
                                       Style="{StaticResource LineValueStyle}"
                                       TextWrapping="Wrap"/>
                            <Border BorderBrush="#BFC5CC" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Right -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="Durumu" Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="18,26,0,0">
                        <TextBlock Text="⇄"
                                   Foreground="#73B300"
                                   FontSize="34"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Devam Ediyor"
                                   FontSize="18"
                                   Foreground="#1F2D3D"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="6" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="160"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DataGrid + Footer -->
            <Grid Grid.Row="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          x:Name="HakedisDetailGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="72"
                          RowHeight="92"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MinHeight="540">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,8,8,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="42">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶"
                                               Foreground="#6E6E6E"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,28,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⌘"
                                               Foreground="#6EA300"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               Margin="0,18,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100"/>
                        <DataGridTextColumn Header="Is&#x0a;Akisi(Fis&#x0a;No)" Binding="{Binding WorkflowReceiptNo}" Width="140"/>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}" Width="150"/>
                        <DataGridTextColumn Header="Servis&#x0a;Fisi&#x0a;Tipi" Binding="{Binding ServiceReceiptType}" Width="120"/>
                        <DataGridTextColumn Header="Cihaz Seri No" Binding="{Binding DeviceSerialNo}" Width="255"/>
                        <DataGridTextColumn Header="Ürün&#x0a;Kodu" Binding="{Binding ProductCode}" Width="125"/>
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="180"/>
                        <DataGridTextColumn Header="İşçilik Adı" Binding="{Binding LaborName}" Width="150"/>
                        <DataGridTextColumn Header="Alt&#x0a;İşçilik&#x0a;Adı" Binding="{Binding SubLaborName}" Width="110"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding Amount}" Width="110"/>

                        <DataGridTemplateColumn Header="" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sil"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            Margin="0,18,0,0"
                                            Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#005A9E"
                                Margin="10,0">
                            <TextBlock Text="1"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBlock Text="1/1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Margin="0,0,22,0"/>

                        <Button Content="⊘ Vazgeç"
                                Width="112"
                                Style="{StaticResource OutlineBlueButtonStyle}"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
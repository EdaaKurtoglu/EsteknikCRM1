<Page x:Class="EsteknikCRM1.Pages.DeviceCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeviceCardsPage">
    <Page.Resources>
    <Style x:Key="ExportButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    </Page.Resources>
      
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Breadcrumb -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Home" Foreground="Gray"/>
            <TextBlock Text="  >  " Foreground="Gray"/>
            <TextBlock Text="Cards" Foreground="Gray"/>
            <TextBlock Text="  >  " Foreground="Gray"/>
            <TextBlock Text="Device Cards"
                       FontWeight="SemiBold"
                       Foreground="#1E3A8A"/>
        </StackPanel>

        <!-- 🔹 Başlık + Search + Add -->
        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Device Cards"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- SEARCH -->
            <Border Grid.Column="1"
                    Height="35"
                    CornerRadius="4"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Background="White"
                    Margin="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SearchButton_Click">
                        <TextBlock Text="🔍"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ADD DEVICE BUTTON -->
            <Button Grid.Column="2"
                Content="+ Add New Device"
                Background="#1E40AF"
                Foreground="White"
                BorderThickness="0"
                Height="35"
                Cursor="Hand"
                Click="AddNewDevice_Click"/>
        </Grid>

        <!-- 🔹 TABLE AREA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="5"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Export -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Copy" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Print" Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>

                <!-- DATA GRID -->
                <DataGrid Grid.Row="1"
                          x:Name="DeviceGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F9FAFB"
                          RowBackground="White"
                          AlternationCount="2"
                          GridLinesVisibility="None"
                          CanUserAddRows="False"
                          Margin="0,15,0,0">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Id" Width="80"
                                            Binding="{Binding Id}"/>

                        <DataGridTextColumn Header="Serial Number"
                                            Width="200"
                                            Binding="{Binding SerialNumber}"/>

                        <DataGridTextColumn Header="Device Code"
                                            Width="120"
                                            Binding="{Binding DeviceCode}"/>

                        <DataGridTextColumn Header="Device Name"
                                            Width="200"
                                            Binding="{Binding DeviceName}"/>

                        <DataGridTextColumn Header="Commissioning Date"
                                            Width="150"
                                            Binding="{Binding CommissionDate}"/>

                        <DataGridTextColumn Header="Brand"
                                            Width="120"
                                            Binding="{Binding Brand}"/>

                        <DataGridTextColumn Header="Top Group"
                                            Width="150"
                                            Binding="{Binding TopGroup}"/>

                        <DataGridTextColumn Header="Sub Group"
                                            Width="150"
                                            Binding="{Binding SubGroup}"/>

                        <DataGridTextColumn Header="Special Group"
                                            Width="150"
                                            Binding="{Binding SpecialGroup}"/>

                        <!-- SELECT BUTTON -->
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Select"
                                            Background="#1E3A8A"
                                            Foreground="White"
                                            Padding="10,4"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="SelectButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</Page>

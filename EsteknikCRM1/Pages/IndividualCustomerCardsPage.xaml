<Page x:Class="EsteknikCRM1.Pages.IndividualCustomerCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d"
      d:DesignWidth="1600"
      d:DesignHeight="900"
      Title="IndividualCustomerCardsPage"
      Background="#F3F3F3">

    <Page.Resources>
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="18,14,18,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BREADCRUMB -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="⌂ Anasayfa"
                           Foreground="#9AA8B6"
                           FontSize="14"/>
                <TextBlock Text="  >  "
                           Foreground="#9AA8B6"
                           FontSize="14"/>
                <TextBlock Text="Kartlar"
                           Foreground="#9AA8B6"
                           FontSize="14"/>
                <TextBlock Text="  >  "
                           Foreground="#9AA8B6"
                           FontSize="14"/>
                <TextBlock Text="Bireysel Müşteri Kartları"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- MAVİ ÇİZGİ -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- BAŞLIK -->
            <TextBlock Grid.Row="2"
                       Text="Bireysel Müşteri Kartları"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,26"/>

            <!-- ARAMA + BUTON -->
            <Grid Grid.Row="3" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="760"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search top -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ara"
                                       Foreground="#9E9E9E"
                                       FontSize="18"
                                       Margin="14,0,0,8"/>
                            <TextBox x:Name="SearchTextBox"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="18"
                                     Padding="14,0,0,0"/>
                            <Border BorderBrush="#BFC5CC"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Add button -->
                    <Button Grid.Row="1"
                            Content="+ Yeni Müşteri Ekle"
                            Width="176"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="AddNewCustomer_Click"/>
                </Grid>
            </Grid>

            <!-- TOOLBAR -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4">
                    <TextBlock Text="Hızlı Arama"
                               FontSize="16"
                               Foreground="Black"
                               Margin="0,0,28,0"
                               VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Kayıt Ara"
                                   FontSize="16"
                                   Foreground="#9E9E9E"
                                   Margin="0,0,0,8"/>
                        <Border Width="155"
                                BorderBrush="#C9CDD2"
                                BorderThickness="0,0,0,1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="5"
                      x:Name="CustomerGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="78"
                      RowHeight="74"
                      FontSize="16"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MinHeight="520">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,8,10,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding CustomerNo}"
                                        Width="85"/>

                    <DataGridTextColumn Header="Müşteri Adı/Soyadı"
                                        Binding="{Binding FullName}"
                                        Width="320"/>

                    <DataGridTextColumn Header="Cep Telefonu&#x0a;Numarası"
                                        Binding="{Binding MobilePhone}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Sabit Telefon&#x0a;Numarası"
                                        Binding="{Binding Phone}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="260"/>

                    <DataGridTextColumn Header="Birincil Adres"
                                        Binding="{Binding Address}"
                                        Width="420"/>

                    <DataGridTextColumn Header="Durum"
                                        Binding="{Binding Status}"
                                        Width="85"/>

                    <DataGridTemplateColumn Header=""
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="İşlem"
                                        Width="72"
                                        Height="40"
                                        Background="#005A9E"
                                        Foreground="White"
                                        BorderBrush="#005A9E"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="SelectButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- PAGINATION -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹"
                            Style="{StaticResource PagerTextButtonStyle}"/>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="2"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="3"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <TextBlock Text="..."
                               FontSize="18"
                               Foreground="#BDBDBD"
                               VerticalAlignment="Center"
                               Margin="12,0"/>

                    <Button Content="87"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Margin="10,0"/>

                    <Button Content="›"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="22"
                            Margin="10,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="1/1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="Black"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
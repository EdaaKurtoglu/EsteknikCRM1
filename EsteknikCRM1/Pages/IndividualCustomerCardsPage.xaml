<Page x:Class="EsteknikCRM1.Pages.IndividualCustomerCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EsteknikCRM1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="IndividualCustomerCardsPage">
    <Page.Resources>
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>
    <Grid>
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 🔹 Breadcrumb -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Home" Foreground="Gray"/>
                <TextBlock Text="  >  " Foreground="Gray"/>
                <TextBlock Text="Cards" Foreground="Gray"/>
                <TextBlock Text="  >  " Foreground="Gray"/>
                <TextBlock Text="Individual Customer Cards"
                       FontWeight="SemiBold"
                       Foreground="#1E3A8A"/>
            </StackPanel>

            <!-- 🔹 Başlık + Search + Add Button -->
            <Grid Grid.Row="1" Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Individual Customer Cards"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                <!-- Search -->
                <TextBox Grid.Column="1"
                     Height="35"
                     VerticalContentAlignment="Center"
                     Padding="10"
                     Margin="10,0"
                     TextChanged="SearchTextBox_TextChanged"/>

                <!-- Add Button -->
                <Button Grid.Column="2"
                    Content="+ Add New Customer"
                    Background="#1E40AF"
                    Foreground="White"
                    Height="35"
                    BorderThickness="0"
                    Cursor="Hand"/>
            </Grid>

            <!-- 🔹 İçerik Alanı -->
            <Border Grid.Row="2"
                Background="White"
                Padding="15"
                CornerRadius="5"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Export Butonları -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Copy" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Print" Style="{StaticResource ExportButtonStyle}"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                          x:Name="CustomerGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F9FAFB"
                          RowBackground="White"
                          AlternationCount="2"
                          GridLinesVisibility="None"
                          Margin="0,15,0,0">

                        <!-- Hover Effect -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- Kolonlar -->
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Customer Name/Surname" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Fixed Phone Number" Binding="{Binding FixedPhone}" Width="140"/>
                            <DataGridTextColumn Header="Phone Number" Binding="{Binding Phone}" Width="140"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Principle Address" Binding="{Binding Address}" Width="300"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>

                            <!-- Select Button Column -->
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Select"
                                            Background="#1E3A8A"
                                            Foreground="White"
                                            Padding="8,4"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="SelectButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>

<Page x:Class="EsteknikCRM1.Pages.ServiceTeamDefinitionsDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="ServiceTeamDefinitionsDetailPage">

    <Page.Resources>
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TabTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Home" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Definitions" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Team Definitions" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Service Team Definitions Operation"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Team Definitions"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,26">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="36,0,0,0">
                        <Border Background="#E9E9E9" Padding="22,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="26" Margin="0,0,12,0"/>
                                <TextBlock Text="Team Main Page" Style="{StaticResource TabTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Height="4" Background="#14A0DB"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="⇄" FontSize="26" Margin="0,0,12,0"/>
                        <TextBlock Text="Workflows" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="◉" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Team Location" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🗎" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Team Competence" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🗓" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Appointments" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="◷" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Operation History" Style="{StaticResource TabTextStyle}"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main content -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="760"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="760"/>
                </Grid.ColumnDefinitions>

                <!-- Left side -->
                <StackPanel Grid.Column="0" Margin="12,0,0,0">
                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Team Data"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <CheckBox x:Name="ActiveCheckBox"
                              Content="Active"
                              IsChecked="True"
                              FontSize="18"
                              Margin="0,0,0,22"/>

                    <TextBlock Text="Team Name"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="BEKİRN ÖZKESEK"
                               Style="{StaticResource FieldValueStyle}"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFBFBF" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                    <TextBlock Text="Car Plaque"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="42AUN582"
                               Style="{StaticResource FieldValueStyle}"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFBFBF" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                    <TextBlock Text="Created Date"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="02/01/2025 10:45 +03:00"
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFBFBF" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                    <TextBlock Text="Deactivation Date"
                               FontSize="13"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,6"/>
                    <TextBlock Text=""
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="#BFBFBF" BorderThickness="0,0,0,1" Margin="0,0,0,38"/>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,20">
                        <TextBlock Text="Team List"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Personnel Name"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="12,0,0,8"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#BFBFBF"
                                BorderThickness="0,0,0,1"
                                Height="38"/>

                        <TextBlock Grid.Column="1"
                                   Text="⌕"
                                   FontSize="28"
                                   Foreground="#2D3A4A"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="TeamMemberGrid"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  BorderBrush="#AEB6BF"
                                  BorderThickness="1"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="White"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="64"
                                  RowHeight="48"
                                  FontSize="16"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  MinHeight="112">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1E1E1E"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="17"/>
                                    <Setter Property="BorderBrush" Value="#AEB6BF"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="10,0,10,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#AEB6BF"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="10,8,10,8"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120"/>
                                <DataGridTextColumn Header="Personnel" Binding="{Binding Personnel}" Width="240"/>
                                <DataGridTextColumn Header="" Binding="{Binding Empty}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <Grid x:Name="EmptyStatePanel"
                              Grid.Row="0"
                              Background="Transparent"
                              Panel.ZIndex="10"
                              IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1"
                                    BorderBrush="#AEB6BF"
                                    BorderThickness="1,0,1,1"
                                    Background="White">
                                <TextBlock Text="No data available in table"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#333"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="EmptyFooterText"
                                   Grid.Row="2"
                                   Text="No record found"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   FontSize="16"
                                   Foreground="Black"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Right side -->
                <StackPanel Grid.Column="2">
                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Team Work Graphic"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>
                    <TextBlock Text="There is no data."
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,24"/>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Team Performance Graphic"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>
                    <TextBlock Text="There is no data."
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,24"/>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Team Workload Graphic"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>
                    <TextBlock Text="There is no data."
                               FontSize="18"
                               Foreground="#B5B5B5"
                               Margin="0,0,0,24"/>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,10">
                        <TextBlock Text="Recent Operation Information"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="⊘ Cancel"
                        Width="104"
                        Margin="0,0,12,0"
                        Style="{StaticResource OutlineBlueButtonStyle}"
                        Click="CancelButton_Click"/>

                <Button Content="💾 Save"
                        Width="92"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
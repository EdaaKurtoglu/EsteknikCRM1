<Page x:Class="EsteknikCRM1.Pages.StockActionDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1600"
      Title="StockActionOperationPage"
      Background="#F3F3F3">

    <Page.Resources>

        <Style x:Key="SectionHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
        </Style>

        <Style x:Key="FlatLineTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="FlatLineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#BFC5CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0A67B2"/>
            <Setter Property="BorderBrush" Value="#0A67B2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Page.Resources>

    <Grid Margin="10,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,14">
            <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="İşlemler" Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="Stok Hareketleri" Foreground="#0A67B2" FontSize="14"/>
            <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
            <TextBlock Text="Stok Hareketleri İşlem" Foreground="#0A67B2" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Mavi çizgi -->
        <Border Grid.Row="1"
                Background="#0A67B2"
                Height="2"
                Margin="8,0,8,22"/>

        <!-- Başlık -->
        <StackPanel Grid.Row="2" Margin="8,0,8,24">
            <TextBlock Text="ES İKLİMLENDİRME VE OTOMASYON SİSTEMLERİ OTOMOTİV TAAHHÜT"
                       FontSize="21"
                       Foreground="Black"
                       Margin="0,0,0,18"/>
            <TextBlock Text="HAYVANCILIK SAN. TİC. LTD. ŞTİ. / Stok Hareketleri"
                       FontSize="21"
                       Foreground="Black"/>
        </StackPanel>

        <!-- Sekmeler -->
        <StackPanel Grid.Row="3" Margin="8,0,8,18">
            <Grid Margin="0,8,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="36,0,0,0">
                    <TextBlock Text="📦  Stok Hareketleri"
                               FontSize="16"
                               Foreground="#1F2D3D"/>
                    <Border Height="4"
                            Background="#14A0DB"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="🏠  Stok Bakiye Listesi"
                           FontSize="16"
                           Foreground="#1F2D3D"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="⇄ İç Transfer Kaydı"
                        Width="170"
                        Style="{StaticResource PrimaryBlueButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="InternalTransferButton_Click"/>
            </Grid>

            <Border BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"/>
        </StackPanel>

        <!-- İçerik -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,0,8">

                <!-- Filtre paneli -->
                <Border Margin="0,0,0,16"
                        Background="Transparent"
                        BorderBrush="#D0D5DA"
                        BorderThickness="1">
                    <StackPanel>

                        <!-- Üst bar -->
                        <Grid Background="#E8E8E8" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                <TextBlock Text="⌃"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Filtreleri Gizle"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           Margin="0,0,28,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="◌"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Filtreleri Sıfırla"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filtre içerik -->
                        <Grid Margin="36,28,36,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SOL -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Servis Depo"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>

                                <Grid Margin="0,0,0,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="ES İKLİMLENDİRME VE OTOMASYON SİSTEMLERİ OTOMOTİV TAAHHÜT HA&#x0a;YVANCILIK SAN. TİC. LTD. ŞTİ."
                                             TextWrapping="Wrap"
                                             BorderThickness="0,0,0,1"
                                             BorderBrush="#BFC5CC"
                                             Background="Transparent"
                                             FontSize="16"
                                             Height="58"
                                             AcceptsReturn="True"/>

                                    <TextBlock Grid.Column="1"
                                               Text="⌄"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Ürün / Yedek Parça / Ek Garanti"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>
                                <TextBox Style="{StaticResource FlatLineTextBoxStyle}"
                                         Margin="0,0,0,28"/>

                                <TextBlock Text="Hareket Başlangıç Tarihi"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePicker Grid.Column="0"
                                                SelectedDate="2026-03-01"
                                                Height="34"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="#BFC5CC"
                                                Background="Transparent"
                                                FontSize="16"/>
                                    <TextBlock Grid.Column="1"
                                               Text="📅"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- SAĞ -->
                            <StackPanel Grid.Column="2">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <RadioButton Content="Ürün" FontSize="16" Margin="0,0,42,0"/>
                                    <RadioButton Content="Yedek Parça" FontSize="16" Margin="0,0,42,0"/>
                                    <RadioButton Content="Ek Garanti" FontSize="16"/>
                                </StackPanel>

                                <TextBlock Text="Hareket Türü"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>
                                <ComboBox Style="{StaticResource FlatLineComboBoxStyle}"
                                          Margin="0,0,0,20">
                                    <ComboBoxItem Content="Lütfen seçiniz..."/>
                                    <ComboBoxItem Content="Giriş"/>
                                    <ComboBoxItem Content="Çıkış"/>
                                </ComboBox>

                                <CheckBox Content="İç Transferler Hariç"
                                          FontSize="16"
                                          Margin="0,4,0,28"/>

                                <TextBlock Text="Hareket Bitiş Tarihi"
                                           Margin="0,0,0,8"
                                           FontSize="13"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePicker Grid.Column="0"
                                                SelectedDate="2026-03-24"
                                                Height="34"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="#BFC5CC"
                                                Background="Transparent"
                                                FontSize="16"/>
                                    <TextBlock Grid.Column="1"
                                               Text="📅"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Alt filtre alanı -->
                        <Grid Margin="36,0,36,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⌃"
                                           Foreground="#0A67B2"
                                           FontSize="16"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="Filtreleri Gizle"
                                           Foreground="#0A67B2"
                                           FontSize="16"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="⎘ Verileri Yenile"
                                    Width="145"
                                    Style="{StaticResource PrimaryBlueButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="RefreshButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Toolbar -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Kopyala" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="CSV" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Excel" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="PDF" Style="{StaticResource ExportButtonStyle}"/>
                        <Button Content="Yazdır" Style="{StaticResource ExportButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,4">
                        <TextBlock Text="Hızlı Arama"
                                   FontSize="16"
                                   Foreground="Black"
                                   Margin="0,0,28,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Kayıt Ara"
                                       FontSize="16"
                                       Foreground="#9E9E9E"
                                       Margin="0,0,0,8"/>
                            <Border Width="160"
                                    BorderBrush="#C9CDD2"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="StockMovementGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#AEB6BF"
                          VerticalGridLinesBrush="#AEB6BF"
                          BorderBrush="#AEB6BF"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="White"
                          RowHeaderWidth="0"
                          ColumnHeaderHeight="70"
                          RowHeight="230"
                          FontSize="16"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,0,10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="#AEB6BF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="10,8,10,8"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="42">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶"
                                               Foreground="#6E6E6E"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,92,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="90"/>
                        <DataGridTemplateColumn Header="Ek Açıklama" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="⟲"
                                               Foreground="#7CC019"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               Margin="0,86,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ek Açıklama 2" Binding="{Binding ExtraDescription2}" Width="140"/>
                        <DataGridTextColumn Header="Servis Adı" Binding="{Binding ServiceName}" Width="210"/>
                        <DataGridTextColumn Header="Ekip Adı" Binding="{Binding TeamName}" Width="110"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="120"/>
                        <DataGridTextColumn Header="Stok Türü" Binding="{Binding StockType}" Width="120"/>
                        <DataGridTextColumn Header="Stok Kodu" Binding="{Binding StockCode}" Width="130"/>
                        <DataGridTextColumn Header="Stok Adı" Binding="{Binding StockName}" Width="110"/>
                        <DataGridTextColumn Header="Hareket Türü" Binding="{Binding MovementType}" Width="120"/>

                        <DataGridTemplateColumn Header="Hareket Durumu" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="+"
                                               FontSize="28"
                                               Foreground="#0097A7"
                                               HorizontalAlignment="Center"
                                               Margin="0,84,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="110"/>
                        <DataGridTextColumn Header="Bakiye" Binding="{Binding Balance}" Width="110"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
<Page x:Class="EsteknikCRM1.Pages.ProductDefinitionOperationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="ProductDefinitionOperationPage">

    <Page.Resources>
        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SearchFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#BFBFBF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ReadOnlyHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
        </Style>

        <Style x:Key="TabTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SquareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="26"
                                    Height="26"
                                    Background="#D9D9D9"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    Margin="0,0,14,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Tanımlar" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Ürün Tanımları" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Ürün Tanımları İşlem"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,22"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Ürün Tanımları"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,26">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="❮"
                               FontSize="34"
                               Foreground="#A9A9A9"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="🗎"
                                       FontSize="22"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Ürün Bilgileri"
                                       Style="{StaticResource TabTextStyle}"/>
                        </StackPanel>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="20,16,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Text="❯"
                               FontSize="34"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Main content -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="760"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="760"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="12,0,0,0">

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Ürün Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Ürün Kodu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="ProductCodeTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Ürün Adı(TR)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="ProductNameTrTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Ürün Adı(ENG)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="ProductNameEnTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Masraf Merkezi"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CostCenterTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchCostCenterButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="B Kodu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BCodeTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchBCodeButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Ürün Yöneticisi"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ProductManagerTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchProductManagerButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Ürün Garanti Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <Grid Margin="0,0,0,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Garanti Süresi (Ay)"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="WarrantyMonth1TextBox"
                                     Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Garanti Süresi2 (Ay)"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="WarrantyMonth2TextBox"
                                     Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Ürün EWL Stok Takip Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <CheckBox x:Name="EwlCheckBox"
                              Content="EWL"
                              Style="{StaticResource SquareCheckBoxStyle}"
                              Margin="0,0,0,22"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EWL Takip Başlangıç"
                                       FontSize="13"
                                       Foreground="#B5B5B5"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker x:Name="EwlStartDatePicker"
                                            Grid.Column="0"
                                            Height="38"
                                            FontSize="16"
                                            BorderBrush="#BFBFBF"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Foreground="#B5B5B5"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅"
                                           FontSize="22"
                                           Foreground="#B5B5B5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EWL Takip Bitiş"
                                       FontSize="13"
                                       Foreground="#B5B5B5"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker x:Name="EwlEndDatePicker"
                                            Grid.Column="0"
                                            Height="38"
                                            FontSize="16"
                                            BorderBrush="#BFBFBF"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Foreground="#B5B5B5"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅"
                                           FontSize="22"
                                           Foreground="#B5B5B5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="2">

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Ürün Grubu Bilgileri"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Marka"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="BrandTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchBrandButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Üst Ürün Grubu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TopGroupTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchTopGroupButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Alt Ürün Grubu"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SubGroupTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchSubGroupButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Ürün Grubu Özel"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SpecialGroupTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchSpecialGroupButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Ülke"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <TextBlock Text="Ülke"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CountryTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchFieldTextBoxStyle}"/>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SearchCountryButton_Click">
                            <TextBlock Text="⌕"
                                       FontSize="28"
                                       Foreground="#2D3A4A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#D9D9D9"
                            Height="46"
                            Padding="20,0,0,0"
                            Margin="0,0,0,22">
                        <TextBlock Text="Diğer Bilgiler"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                    </Border>

                    <CheckBox x:Name="CascadeSystemCheckBox"
                              Content="Kaskad Sistemi"
                              Style="{StaticResource SquareCheckBoxStyle}"
                              Margin="0,0,0,22"/>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="PhaseOutCheckBox"
                                  Grid.Column="0"
                                  Content="Phase Out"
                                  Style="{StaticResource SquareCheckBoxStyle}"
                                  Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phase Out Tarihi"
                                       FontSize="13"
                                       Foreground="#B5B5B5"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker x:Name="PhaseOutDatePicker"
                                            Grid.Column="0"
                                            Height="38"
                                            FontSize="16"
                                            BorderBrush="#BFBFBF"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Foreground="#B5B5B5"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅"
                                           FontSize="22"
                                           Foreground="#B5B5B5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="SapPhaseOutCheckBox"
                                  Grid.Column="0"
                                  Content="SAP Phase Out"
                                  Style="{StaticResource SquareCheckBoxStyle}"
                                  Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SAP Phase Out Tarihi"
                                       FontSize="13"
                                       Foreground="#B5B5B5"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker x:Name="SapPhaseOutDatePicker"
                                            Grid.Column="0"
                                            Height="38"
                                            FontSize="16"
                                            BorderBrush="#BFBFBF"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Foreground="#B5B5B5"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅"
                                           FontSize="22"
                                           Foreground="#B5B5B5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="NoSerialNumberCheckBox"
                              Content="Seri No Yok"
                              Style="{StaticResource SquareCheckBoxStyle}"
                              Margin="0,0,0,22"/>

                    <TextBlock Text="Üretim Yeri"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="ProductionPlaceTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Satış Bilgisi"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="SalesInfoTextBox"
                             Style="{StaticResource FieldValueStyle}"
                             Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="⊘ Vazgeç"
                        Width="110"
                        Style="{StaticResource OutlineBlueButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
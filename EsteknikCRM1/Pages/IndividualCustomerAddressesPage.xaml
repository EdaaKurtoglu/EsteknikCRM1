<Page x:Class="EsteknikCRM1.Pages.IndividualCustomerAddressesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F3F3F3"
      Title="IndividualCustomerAddressesPage">

    <Page.Resources>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#7FAED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="OperationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="16,10,16,10" MinWidth="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,14">
                <TextBlock Text="⌂ Anasayfa" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Kartlar" Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Bireysel Müşteri Kartları" Foreground="#0A67B2" FontSize="14"/>
                <TextBlock Text="  >  " Foreground="#9AA8B6" FontSize="14"/>
                <TextBlock Text="Bireysel Müşteri Kart İşlem"
                           Foreground="#0A67B2"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Blue line -->
            <Border Grid.Row="1"
                    Background="#0A67B2"
                    Height="2"
                    Margin="0,0,0,20"/>

            <!-- Title -->
            <TextBlock Grid.Row="2"
                       Text="Bireysel Müşteri İşlemleri"
                       FontSize="22"
                       Foreground="Black"
                       Margin="0,0,0,24"/>

            <!-- Tabs -->
            <StackPanel Grid.Row="3" Margin="0,0,0,26">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="❮"
                               FontSize="34"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Bireysel Müşteri Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Müşteri Adresleri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                        <Border Height="4"
                                Background="#14A0DB"
                                Margin="0,16,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Müşteri Yakınları"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="İş Akışı Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Cihaz Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Kupon Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="7" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗓" FontSize="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Randevu Bilgileri"
                                       FontSize="16"
                                       Foreground="#1F2D3D"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="8"
                               Text="❯"
                               FontSize="34"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>

                <Border BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- Top toolbar -->
            <Grid Grid.Row="4" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Kopyala" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Excel" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="PDF" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="Yazdır" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <Button Content="+ Yeni Adres Ekle"
                            Width="160"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BlueButtonStyle}"
                            Click="AddNewAddress_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="Hızlı Arama"
                                   FontSize="16"
                                   Foreground="Black"
                                   Margin="0,0,28,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Kayıt Ara"
                                       FontSize="16"
                                       Foreground="#9E9E9E"
                                       Margin="0,0,0,8"/>
                            <Border Width="160"
                                    BorderBrush="#C9CDD2"
                                    BorderThickness="0,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Grid.Row="5"
                      x:Name="AddressGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#AEB6BF"
                      VerticalGridLinesBrush="#AEB6BF"
                      BorderBrush="#AEB6BF"
                      BorderThickness="1"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="86"
                      RowHeight="175"
                      FontSize="16"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E1E1E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#AEB6BF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,8,10,8"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Adres" Binding="{Binding AddressLine}" Width="190"/>
                    <DataGridTextColumn Header="Daire" Binding="{Binding FlatNo}" Width="105"/>
                    <DataGridTextColumn Header="Apartman&#x0a;No" Binding="{Binding BuildingNo}" Width="150"/>
                    <DataGridTextColumn Header="Sokak/Cadde" Binding="{Binding Street}" Width="180"/>
                    <DataGridTextColumn Header="Semt" Binding="{Binding Neighborhood}" Width="160"/>
                    <DataGridTextColumn Header="İlçe" Binding="{Binding District}" Width="115"/>
                    <DataGridTextColumn Header="İl" Binding="{Binding City}" Width="90"/>
                    <DataGridTextColumn Header="Ülke" Binding="{Binding Country}" Width="100"/>
                    <DataGridTextColumn Header="İkametgah&#x0a;Adresi Mi?" Binding="{Binding IsResidenceText}" Width="150"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Mülkiyet Tipi" Binding="{Binding OwnershipType}" Width="170"/>

                    <DataGridTemplateColumn Header="" Width="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sil"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        Margin="0,56,0,0"
                                        Click="DeleteAddress_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="İşlem"
                                        Style="{StaticResource OperationButtonStyle}"
                                        Margin="0,56,0,0"
                                        Click="OperationAddress_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pagination -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource PagerButtonStyle}"/>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#005A9E"
                            Margin="10,0">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="›" Style="{StaticResource PagerButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="1/1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="Black"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
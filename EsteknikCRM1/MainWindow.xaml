<Window x:Class="EsteknikCRM1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F2F2F2">

    <Grid>

        <!-- Arka Plan -->
        <Grid.Background>
            <ImageBrush ImageSource="/assets/background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- 2 Satırlı Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST BAR -->
        <Grid Grid.Row="0"
              Background="Transparent">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <!-- Minimize -->
                <Button Content="─"
                        Width="50"
                        Height="40"
                        BorderThickness="0"
                        FontSize="18"
                        Cursor="Hand"
                        Click="Minimize_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DDDDDD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close -->
                <Button Content="X"
                        Width="50"
                        Height="40"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        Click="Close_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Red"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ANA İÇERİK -->
        <Grid Grid.Row="1">

            <!-- Ortadaki Kart -->
            <Border Width="450"
                    Padding="30"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <Button Content="İŞ ORTAKLARI GİRİŞ"
                            Height="70"
                            Margin="0,0,0,20"
                            Background="#125A8A"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PartnerLogin_Click"/>

                    <Button Content="BOSCH ÇALIŞANI GİRİŞ"
                            Height="70"
                            Background="#125A8A"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BoschLogin_Click"/>

                    <TextBlock Text="Need Help?"
                               Margin="0,25,0,5"
                               HorizontalAlignment="Center"
                               Foreground="Gray"
                               Cursor="Hand"/>

                    <TextBlock Text="Corporate Information"
                               HorizontalAlignment="Center"
                               Foreground="Gray"
                               Cursor="Hand"/>

                </StackPanel>
            </Border>

            <!-- Sağ Alt Warning -->
            <Border Background="#F6A623"
                    Width="350"
                    Padding="20"
                    CornerRadius="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40">

                <StackPanel>
                    <TextBlock Text="⚠ Warning"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="You are not allowed to share your location information with us. Please allow location sharing."
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="White"/>
                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Window>

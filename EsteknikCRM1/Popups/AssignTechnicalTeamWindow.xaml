<Window x:Class="EsteknikCRM1.Popups.AssignTechnicalTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Takım Bilgileri"
        Height="310"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Grid Background="#66000000">

        <Border Width="748"
                Height="290"
                Background="White"
                CornerRadius="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Takım Bilgileri"
                               FontSize="22"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"/>

                    <Button x:Name="CloseButton"
                            Content="×"
                            Width="47"
                            Height="36"
                            FontSize="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#222"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="696,0,0,0"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- BLUE LINE -->
                <Border Grid.Row="1"
                        Background="#0A67B2"/>

                <!-- CONTENT -->
                <Grid Grid.Row="2" Margin="26,20,26,10">
                    <StackPanel>
                        <TextBlock Text="Takım"
                                   FontSize="14"
                                   Foreground="#222"
                                   Margin="4,0,0,8"/>

                        <Border BorderBrush="#BFC5CC"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,8">
                            <ComboBox x:Name="TeamComboBox"
                                      Height="42"
                                      FontSize="17"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Padding="0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Lütfen seçiniz..."/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- FOOTER -->
                <Grid Grid.Row="3" Margin="0,0,20,0">
                    <Button x:Name="SaveButton"
                            Content="Kaydet"
                            Width="88"
                            Height="52"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#005A9E"
                            Foreground="White"
                            BorderBrush="#005A9E"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
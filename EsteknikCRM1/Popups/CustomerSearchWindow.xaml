<Window x:Class="EsteknikCRM1.Popups.CustomerSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Individual Customer"
        Height="620"
        MaxHeight="950"
        Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#F2F4F7"
        ResizeMode="NoResize">

    <Grid>

        <!-- Popup Card -->

        <Border Background="White"
        Margin="30"
        CornerRadius="6"
        Padding="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.25"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0" x:Name="ResultRow"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->

                    <TextBlock Text="Search Individual Customer"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,25"/>

                    <!-- FORM -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Customer Name"/>
                            <TextBox Height="32" Margin="0,5,0,15"/>

                            <TextBlock Text="Customer Midname"/>
                            <TextBox Height="32" Margin="0,5,0,15"/>

                            <TextBlock Text="Customer Surname"/>
                            <TextBox Height="32" Margin="0,5,0,15"/>

                            <TextBlock Text="Tel Number"/>
                            <TextBox Height="32" Margin="0,5,0,15"/>

                            <CheckBox Content="All" Margin="0,10,0,0"/>

                        </StackPanel>

                        <!-- RIGHT -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Serial Device Nr"/>
                            <TextBox Height="32" Margin="0,5,0,15"/>

                            <!-- CITY -->

                            <TextBlock Text="City"/>

                            <Grid Margin="0,5,0,15">

                                <TextBox Height="32" Padding="5,0,30,0"/>

                                <Button Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                    <TextBlock Text="🔍" FontSize="14"/>

                                </Button>

                            </Grid>

                            <!-- DISTRICT -->

                            <TextBlock Text="District"/>

                            <Grid Margin="0,5,0,15">

                                <TextBox Height="32" Padding="5,0,30,0"/>

                                <Button Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                    <TextBlock Text="🔍" FontSize="14"/>

                                </Button>

                            </Grid>

                            <TextBlock Text="Address"/>
                            <TextBox Height="32" Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                    <!-- SEARCH BUTTON -->

                    <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,25,0,0">

                        <Button Content="Search"
                            Width="120"
                            Height="35"
                            Background="#1976D2"
                            Foreground="White"
                            BorderBrush="#1976D2"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Search_Click"/>

                    </StackPanel>
                    <DataGrid x:Name="CustomerGrid"
                      Grid.Row="3"
                      Visibility="Collapsed"
                      Margin="0,20,0,0"
                      AutoGenerateColumns="False"
                      Height="200">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                            Binding="{Binding Id}"
                            Width="80"/>

                            <DataGridTemplateColumn Header="Müşteri Adı" Width="*">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="Surname"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTextColumn Header="Sabit Telefon"
                            Binding="{Binding Phone}"
                            Width="*"/>

                            <DataGridTextColumn Header="Mobil Telefon"
                            Binding="{Binding Phone}"
                            Width="*"/>

                            <DataGridTextColumn Header="Adres"
                            Binding="{Binding City}"
                            Width="*"/>

                            <DataGridTemplateColumn Header="Select" Width="100">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Select"
                                        Padding="10,3"
                                        Background="#2E7D32"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="SelectCustomer_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
<Window x:Class="EsteknikCRM1.Popups.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Değiştir"
        Height="441"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Şifre Değiştir"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Mevcut Şifre" Margin="0,0,0,6"/>
            <PasswordBox x:Name="CurrentPasswordBox" Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Yeni Şifre" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox" Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Yeni Şifre Tekrar" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Vazgeç"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Kaydet"
                    Width="100"
                    Height="38"
                    Background="#1565C0"
                    Foreground="White"
                    BorderBrush="#1565C0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>